---
import "../styles/global.css";
import { SITE_URL, SOCIAL_PROFILE_URLS } from "../config/brand";
import { getHtmlLang, getLocale, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

const GOOGLE_ANALYTICS_MEASUREMENT_ID = "G-BT2BNJWV11";

interface Props {
  title: string;
  description: string;
  browserTitle?: string;
  canonicalPath?: string;
  bodyClass?: string;
  lang?: Lang;
  alternates?: Partial<Record<Lang, string>>;
  ogType?: "website" | "article";
  ogImageAlt?: string;
  articlePublishedTime?: Date | string;
  articleModifiedTime?: Date | string;
  articleAuthorUrl?: string;
  articleSection?: string;
  articleTags?: string[];
  enableRevealAnimations?: boolean;
  preloadDisplayFont?: boolean;
}

const {
  title,
  description,
  browserTitle,
  canonicalPath = "",
  bodyClass = "",
  lang = "en",
  alternates,
  ogType = "website",
  ogImageAlt = "KnitTools knitting app and tools",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthorUrl,
  articleSection,
  articleTags = [],
  enableRevealAnimations = false,
  preloadDisplayFont = true,
} = Astro.props;
const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const fullTitle = `${title} | KnitTools`;
const pageTitle = browserTitle ?? fullTitle;
const ogLocale = getLocale(lang);
const htmlLang = getHtmlLang(lang);
const t = useTranslations(lang);
const enableGoogleAnalytics = import.meta.env.PROD;
const googleAnalyticsSnippet = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', ${JSON.stringify(GOOGLE_ANALYTICS_MEASUREMENT_ID)});
`;

const toIsoDateTime = (value?: Date | string): string | undefined => {
  if (!value) return undefined;
  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.valueOf()) ? String(value) : date.toISOString();
};

const articlePublishedIso = toIsoDateTime(articlePublishedTime);
const articleModifiedIso = toIsoDateTime(articleModifiedTime);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    {
      enableGoogleAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_MEASUREMENT_ID}`}
          />
          <script is:inline data-csp-hash set:html={googleAnalyticsSnippet} />
        </>
      )
    }
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F4EAD9" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates &&
        Object.entries(alternates).map(([alternateLang, path]) => (
          <link
            rel="alternate"
            hreflang={getHtmlLang(alternateLang as Lang)}
            href={`${SITE_URL}${path}`}
          />
        ))
    }
    {
      alternates && alternates.en && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={`${SITE_URL}${alternates.en}`}
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/images/og-image.png`} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KnitTools" />
    <meta property="og:locale" content={ogLocale} />
    {
      alternates &&
        Object.keys(alternates)
          .filter((alternateLang) => alternateLang !== lang)
          .map((alternateLang) => (
            <meta
              property="og:locale:alternate"
              content={getLocale(alternateLang as Lang)}
            />
          ))
    }
    {
      ogType === "article" && articlePublishedIso && (
        <meta property="article:published_time" content={articlePublishedIso} />
      )
    }
    {
      ogType === "article" && articleModifiedIso && (
        <meta property="article:modified_time" content={articleModifiedIso} />
      )
    }
    {
      ogType === "article" && articleAuthorUrl && (
        <meta property="article:author" content={articleAuthorUrl} />
      )
    }
    {
      ogType === "article" && articleSection && (
        <meta property="article:section" content={articleSection} />
      )
    }
    {
      ogType === "article" &&
        articleTags.map((tag) => <meta property="article:tag" content={tag} />)
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/images/og-image.png`} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {SOCIAL_PROFILE_URLS.map((href) => <link rel="me" href={href} />)}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="/fonts/teko-500-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      preloadDisplayFont && (
        <link
          rel="preload"
          href="/fonts/lalezar-latin.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/general-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Global styles imported via frontmatter -->
    {
      enableRevealAnimations && (
        <script is:inline data-csp-hash>
          document.documentElement.classList.add("reveal-animations");
        </script>
      )
    }
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">{t("skipToContent")}</a>
    <div class="page-wrapper">
      <slot />
    </div>
    <script></script>
    {
      enableRevealAnimations && (
        <script>
          import {initRevealAnimations} from "../scripts/revealAnimations";
          initRevealAnimations();
        </script>
      )
    }
    <script>
      import {
        COUNTRY_TO_TIER,
        FALLBACK_PRICING_TIER,
        PRICING,
        getLaunchPhase,
        getPricePhase,
      } from "../config/pricing";

      const countryStorageKey = "knittools-pricing-country";
      let currentTier = "US";
      let boundaryTimer: number | undefined;

      const refreshPricing = () => {
        const now = Date.now();
        const phase = getLaunchPhase(
          now,
          PRICING.launchStartMs,
          PRICING.launchEndMs,
        );
        const pricePhase = getPricePhase(phase);
        document
          .querySelectorAll<HTMLElement>("[data-regional-price]")
          .forEach((el) => {
            const selectedPhase = el.hasAttribute("data-current-price")
              ? pricePhase
              : el.dataset.regionalPrice;
            const value = el.getAttribute(
              `data-${currentTier.toLowerCase()}-${selectedPhase}`,
            );
            if (value) el.textContent = value;
          });
        document
          .querySelectorAll<HTMLElement>("[data-campaign-phase]")
          .forEach((el) => {
            el.hidden = el.dataset.campaignPhase !== phase;
          });
        document
          .querySelectorAll<HTMLElement>("[data-release-availability]")
          .forEach((el) => {
            el.textContent =
              phase === "prelaunch"
                ? "The release date has not been announced yet."
                : "KnitTools is available on Google Play.";
          });
        const schema = document.querySelector<HTMLScriptElement>(
          "script[data-pricing-schema]",
        );
        if (schema?.textContent) {
          const data = JSON.parse(schema.textContent);
          const app = data["@graph"].find(
            (item: { "@type": string }) =>
              item["@type"] === "SoftwareApplication",
          );
          if (app)
            app.offers = JSON.parse(
              schema.getAttribute(`data-${pricePhase}-offers`) || "[]",
            );
          schema.textContent = JSON.stringify(data);
        }
        window.clearTimeout(boundaryTimer);
        const validWindow =
          PRICING.launchStartMs !== null &&
          PRICING.launchEndMs !== null &&
          Number.isFinite(PRICING.launchStartMs) &&
          Number.isFinite(PRICING.launchEndMs) &&
          PRICING.launchStartMs < PRICING.launchEndMs;
        if (validWindow) {
          const boundary =
            phase === "prelaunch"
              ? PRICING.launchStartMs
              : phase === "launch"
                ? PRICING.launchEndMs
                : null;
          if (boundary !== null && boundary > now) {
            boundaryTimer = window.setTimeout(
              refreshPricing,
              Math.min(boundary - now, 2_147_483_647),
            );
          }
        }
      };

      const getCountry = async () => {
        try {
          const cached = sessionStorage.getItem(countryStorageKey);
          if (cached) return cached;
        } catch {
          /* Storage can be unavailable in privacy modes. */
        }
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 1200);
        try {
          const response = await fetch("/cdn-cgi/trace", {
            cache: "no-store",
            signal: controller.signal,
          });
          if (!response.ok) return "";
          const trace = await response.text();
          const country = trace.match(/^loc=([A-Z]{2})$/m)?.[1] || "";
          if (country) {
            try {
              sessionStorage.setItem(countryStorageKey, country);
            } catch {
              /* Optional cache. */
            }
          }
          return country;
        } catch {
          return "";
        } finally {
          window.clearTimeout(timeout);
        }
      };
      refreshPricing();
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") refreshPricing();
      });
      getCountry().then((country) => {
        currentTier = country
          ? COUNTRY_TO_TIER[country.toUpperCase()] || FALLBACK_PRICING_TIER
          : "US";
        refreshPricing();
      });
    </script>
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "90537a60e26f433485a8fdaf6b076843"}'
    ></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>
