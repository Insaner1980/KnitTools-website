---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import { routes } from "../../../i18n/routes";

type Category =
  | "cast-on-bind-off"
  | "increases"
  | "decreases"
  | "cables"
  | "lace"
  | "general"
  | "stitch-patterns";

interface Abbreviation {
  abbr: string;
  def: string;
  search: string;
  categories: Category[];
}

const categoryLabels: Record<Category, string> = {
  "cast-on-bind-off": "Opplegg / avfelling",
  increases: "Økninger",
  decreases: "Fellinger",
  cables: "Fletter",
  lace: "Hullmønster",
  general: "Generelt",
  "stitch-patterns": "Maskemønstre",
};

