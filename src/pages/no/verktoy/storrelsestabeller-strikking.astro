];

const defaultPanel = "dame";

const faqs = [
  {
    q: "Er disse målene like i alle strikkeoppskrifter?",
    a: "CYC publiserer referansetabeller, men alle strikkeoppskrifter bruker ikke samme størrelsessystem. Designere kan ha egne mål og størrelsesnavn. Sjekk alltid oppskriftens egen størrelsestabell og målskisse.",
  },
  {
    q: "Hvordan velger jeg størrelse hvis oppskriften bruker tall i stedet for XS/S/M/L?",
    a: "Bruk oppskriftens mål, ikke bare tallet eller bokstaven. Sjekk om målene gjelder kroppen eller det ferdige plagget; ta hensyn til tiltenkt bevegelsesvidde ved ferdige mål. For en genser sammenligner du brystmål og andre mål som er viktige for passformen.",
  },
  {
    q: "Skal jeg måle over klær eller rett på huden?",
    a: "Mål på bar hud eller over et tynt, tettsittende lag, og unngå tykke klær. En tykk genser legger til centimeter som ikke beskriver kroppsmålet oppskriftens størrelsestabell spør etter.",
  },
  {
    q: "Hva gjør jeg hvis målene mine ikke passer pent i én størrelse?",
    a: "Det er normalt. De fleste er ikke én størrelse på alle mål. Prioriter målet som er viktigst for plagget: brystmål for en genser, hofte for et skjørt, hodeomkrets for en lue. Mange oppskrifter har instruksjoner for å forlenge eller forkorte enkelte deler.",
  },
];
---

<LocalizedToolPage
  title="Størrelsestabeller for strikking"
  description="Standardiserte kroppsmål for strikking. Størrelser fra baby til voksen med bryst, midje, hofte, ermelengde og mer, i cm og tommer."
  canonicalPath={routes.tool.knittingSizeCharts.no}
  lang="no"
  alternates={routes.tool.knittingSizeCharts}
  intro="Standardmål for strikkeprosjekter. Velg kategori og måleenhet for å se tabellen."
  schemaName="Størrelsestabeller for strikking"
  schemaDescription="Referansetabeller med standardiserte kroppsmål for strikking, fra baby til voksenstørrelser."
  faqs={faqs}
  variant="terracotta"
  enableSizeChartControls
>
  <div slot="tool" data-size-chart data-mobile-size-label="Velg størrelse">
    <p class="panel-intro">
      Dette er kroppsmål, ikke ferdige plaggmål. Legg til bevegelsesvidde for
      passformen du vil ha.
    </p>
    <p class="panel-intro">
      Dette er CYCs veiledende kroppsmål, ikke ferdige plaggmål eller
      universelle størrelser. Tallene for barn og ungdom er amerikanske
      referansestørrelser, ikke alder eller europeiske høydestørrelser.
      Babyalder er omtrentlig. XS–5XL følger CYC; 2XL–5XL tilsvarer deres 2X–5X.
      Mål personen og bruk oppskriftens egen størrelsestabell.
    </p>
    <p class="panel-intro" id="size-source-note">
      CM og tommer viser CYCs publiserte, avrundede par, ikke nøyaktige
      omregninger. Seks mål mangler bekreftede kildeverdier fordi de publiserte
      verdiene er motstridende. Begge verdiene er utelatt. Mål kroppen etter
      veiledningen nedenfor, og sjekk oppskriftens størrelsesguide og tiltenkte
      bevegelsesvidde.
    </p>
    <div class="chart-controls">
      <div class="tab-scroller">
        <div class="tabs" role="tablist" aria-label="Størrelseskategori">
          {
            panels.map((panel) => (
              <button
                type="button"
                role="tab"
                class={`tab-btn${panel.id === defaultPanel ? " is-active" : ""}`}
                data-tab={panel.id}
                aria-selected={panel.id === defaultPanel ? "true" : "false"}
                aria-controls={`panel-${panel.id}`}
                id={`tab-${panel.id}`}
                tabindex={panel.id === defaultPanel ? 0 : -1}
              >
                {panel.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="unit-toggle" role="radiogroup" aria-label="Måleenhet">
        <button
          type="button"
          role="radio"
          class="unit-btn is-active"
          data-unit="cm"
          tabindex="0"
          aria-checked="true">CM</button
        >
        <button
          type="button"
          role="radio"
          class="unit-btn"
          data-unit="inch"
          tabindex="-1"
          aria-checked="false">Tommer</button
        >
      </div>
    </div>

    <div class="chart-wrap show-cm" id="no-size-chart-wrap">
      {
        panels.map((panel) => (
          <div
            class={`panel${panel.id === defaultPanel ? " is-active" : ""}`}
            data-panel={panel.id}
            role="tabpanel"
            tabindex="0"
            id={`panel-${panel.id}`}
            aria-labelledby={`tab-${panel.id}`}
            hidden={panel.id !== defaultPanel}
          >
            {panel.intro && <p class="panel-intro">{panel.intro}</p>}
            {panel.tables.map((table) => (
              <div class="table-block">
                {table.caption && (
                  <h3 class="table-caption">{table.caption}</h3>
                )}
                <div class="table-scroll">
                  <table class="size-table">
                    <thead>
                      <tr>
                        <th scope="col" class="sticky-col">
                          {table.sizeHeader ?? "Mål"}
                        </th>
                        {table.sizes.map((size) => (
                          <th scope="col">{size}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr>
                          <th scope="row" class="sticky-col row-label">
                            {row.label}
                          </th>
                          {row.cells.map((cell) => (
                            <td
                              data-unavailable={cell.cm === null || undefined}
                              aria-describedby={
                                cell.cm === null
                                  ? "size-source-note"
                                  : undefined
                              }
                            >
                              <span class="unit-cm">
                                {formatCm(cell.cm ?? unavailableValue)}
                              </span>
                              <span class="unit-inch">
                                {formatInch(cell.inch ?? unavailableValue)}
                              </span>
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div slot="content">
    <h2>Slik tar du kroppsmål</h2>
    <p>
      Målene i disse tabellene viser bestemte punkter på kroppen. For å få et
      nyttig mål må du måle på riktig sted.
    </p>
    <p>
      <strong>Bryst / byste:</strong> Mål rundt den fyldigste delen av brystet, med
      målebåndet vannrett og inntil kroppen uten å stramme. Dette er hovedmålet for
      å velge plaggstørrelse.
    </p>
    <p>
      <strong>Midje:</strong> Mål ved den naturlige midjen, det smaleste punktet på
      overkroppen, ofte like over navlen. Bøy deg til siden hvis du er usikker; folden
      viser hvor midjen sitter.
    </p>
    <p>
      <strong>Hofte:</strong> Mål rundt den bredeste delen av hoften og hold målebåndet
      vannrett. Bruk kroppens bredeste punkt, ikke en fast avstand under midjen.
    </p>
    <p>
      <strong>Ryggbredde:</strong> Mål rett over ryggen fra ytterpunktet på den ene
      skulderen til den andre. Det avgjør plaggets skulderbredde.
    </p>
    <p>
      <strong>Rygglengde til midje:</strong> Mål fra den tydelige kulen i nakken og
      rett ned til den naturlige midjen. Det avgjør hvor lang bolen trenger å være.
    </p>
    <p>
      <strong>Rygglengde til hofte (herre):</strong> Herretabellen følger CYCs PDF
      og måles fra nakken til hoften, ikke til midjen. Sjekk målepunktet mot oppskriftens
      målskisse.
    </p>
    <p>
      <strong>Armlengde: armhule til håndledd:</strong> Mål fra armhulen til håndleddet
      med armen lett bøyd. Kroppsmålet er et utgangspunkt for ermelengden, ikke et
      ferdig ermemål.
    </p>
    <p>
      <strong>Overarmsvidde:</strong> Mål rundt overarmens fyldigste del, med armen
      avslappet langs siden.
    </p>
    <p>
      <strong>Ermehullsdybde:</strong> Mål loddrett fra skulderens ytre overkant ned
      til armhulen.
    </p>
    <p>
      <strong>Nakke til håndledd midt bak:</strong> Hold armen rett og mål fra nakkens
      basis midt bak, over skulderen og langs armen til håndleddet.
    </p>
    <p>
      <strong>Mål til tilbehør:</strong> Mål hodeomkretsen over pannen og rundt hele
      hodet, fotlengden på gulvet fra baksiden av hælen til den lengste tåen, og håndomkretsen
      rundt håndflaten på den dominante hånden like nedenfor knokene, uten tommelen.
      Dette er kroppsmål, ikke ferdige mål på luer, sokker eller votter. Fotlengde
      er ikke en omregning av skostørrelse og er ikke nok alene til å velge sokkestørrelse.
      Aldersangivelsene er veiledende.
    </p>

    <h2>Kroppsmål kontra ferdige plaggmål</h2>
    <p>
      Tabellene viser kroppsmål. Det ferdige plagget kan være mindre, like stort
      eller større, avhengig av oppskriftens tiltenkte bevegelsesvidde.
    </p>
    <p>
      <strong>Negativ bevegelsesvidde:</strong> Plagget er mindre enn kroppen. For
      en svært kroppsnær genser er CYCs veiledning omtrent 5-10 cm mindre enn faktisk
      brystmål; luer, sokker og tettsittende vrangbord har egne prosjektspesifikke
      krav til hvor stramt de skal sitte.
    </p>
    <p>
      <strong>Null bevegelsesvidde:</strong> Det ferdige plaggmålet er lik det tilsvarende
      kroppsmålet.
    </p>
    <p>
      <strong>Positiv bevegelsesvidde:</strong> Plagget er større enn kroppen. CYC
      foreslår omtrent 5–10 cm ekstra rundt brystet for klassisk genserpassform, ikke
      som en regel for alle modeller.
    </p>
    <p>
      <strong>Løs og oversized passform:</strong> CYC foreslår omtrent 10–15 cm ekstra
      rundt brystet for en løs genser og 15 cm eller mer for en oversized genser.
    </p>
    <p>
      Hvis oppskriften passer et brystmål på 91,5 cm og det ferdige plagget
      måler 101,5 cm, er den positive bevegelsesvidden 10 cm. Sammenlign både
      oppskriftens kroppsmål og målskissens ferdige mål med ønsket passform.
    </p>
    <p>
      Når du vet målstørrelsen, kan <a href={routes.tool.yarnEstimator.no}
        >garnberegneren</a
      > sjekke om garnmengden virker rimelig, og <a
        href={"/no/artikler/hvor-mye-garn-til-genser/"}
        >guiden til garn for genser</a
      > går dypere inn i størrelsesberegninger.
    </p>

    <h2>Å velge mellom størrelser</h2>
    <p>
      Mellom to størrelser: sammenlign ferdige mål med kroppen og oppskriftens
      tiltenkte bevegelsesvidde. Ikke velg automatisk mindre størrelse for
      kroppsnært eller større for oversized. Maskemønster, fiber og en vasket,
      tørket prøvelapp påvirker elastisitet og fall. Luer og sokker trenger sin
      egen oppskriftsbestemte bevegelsesvidde; et fast tillegg garanterer ikke
      passformen.
    </p>
    <p>
      Sammenlign også andre mål, særlig hofte for lengre plagg og overarm for
      tettsittende ermer. Hvis brystet sier M, men hoften sier L, sjekk
      oppskriftens målskisse for å se om hofteforskjellen betyr noe for plaggets
      lengde og silhuett.
    </p>
    <p>
      Uansett hvilken størrelse du velger, avgjør <a
        href={"/no/artikler/strikke-provelapp-steg-for-steg/"}>prøvelappen</a
      > om det ferdige arbeidet faktisk matcher oppskriftens tall. Guiden <a
        href={"/no/artikler/male-strikkefasthet/"}
        >slik måler du strikkefasthet</a
      > går gjennom prøvelappen i detalj.
    </p>

    <h2>Kilder og målemetoder</h2>
    <p>
      <a href="https://www.craftyarncouncil.com/standards/body-sizing"
        >Craft Yarn Council: Kilder og målemetoder</a
      >. <a href="https://www.craftyarncouncil.com/standards/baby-size-chart"
        >Baby</a
      >, <a href="https://www.craftyarncouncil.com/standards/child-youth-sizes"
        >Barn og ungdom</a
      >, <a href="https://www.craftyarncouncil.com/standards/woman-size">Dame</a
      >, <a href="https://www.craftyarncouncil.com/standards/man-size">Herre</a
      >, <a
        href="https://www.craftyarncouncil.com/standards/head-circumference-chart"
        >Hode</a
      >, <a href="https://www.craftyarncouncil.com/standards/foot-size-charts"
        >Fot</a
      >, <a href="https://www.craftyarncouncil.com/standards/hand-size-charts"
        >Hånd</a
      >. <a
        href="https://media.craftyarncouncil.com/sites/default/files/images/standards/CYC_YarnStandards-2018-11-06.pdf"
        >CYC PDF</a
      >.
    </p>
    <p>
      Kilde: Craft Yarn Council. PDF-en det lenkes til (sidene 17–18), avklarer
      to feil i nettabellene: overarmsvidden for dame 5XL er 19,5 tommer, og
      herrenes rygglengde går til hoften, ikke midjen. De seks øvrige
      motsetningene i kilden er fortsatt uavklart. Nettstedet utelater begge
      enhetsverdiene for disse målene og erstatter dem ikke med korrigerte eller
      beregnede verdier.
    </p>
  </div>
</LocalizedToolPage>
