---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import WpiIdentifier from "../../../components/WpiIdentifier.astro";
import { routes } from "../../../i18n/routes";
import { getLocalizedYarnWeightRows } from "../../../lib/toolReferenceData";

const yarnWeightCopy = [
  {
    name: "Lace / dentelle",
    regional: "Cobweb / Light fingering / 2-ply",
    uses: "Châles en dentelle, napperons, points ajourés fins",
  },
  {
    name: "Fingering / Sock",
    regional: "Sock / Fingering / Baby / 4-ply",
    uses: "Chaussettes, layette, châles fins, vêtements légers",
  },
  {
    name: "Sport",
    regional: "Sport / Baby / 5-ply",
    uses: "Vêtements légers, layette, accessoires",
  },
  {
    name: "DK / Light",
    regional: "DK / Light Worsted / 8-ply",
    uses: "Pulls, bonnets, écharpes, couvertures bébé, vêtements d'entre-saison",
  },
  {
    name: "Worsted / Aran / Medium",
    regional: "Worsted / Aran / Afghan / 10-ply",
    uses: "Pulls, bonnets, moufles, couvertures, la plupart des tricots du quotidien",
  },
  {
    name: "Bulky / Chunky",
    regional: "Chunky / Craft / Rug / 12-ply",
    uses: "Pulls épais, écharpes, couvertures, projets rapides",
  },
  {
    name: "Super Bulky",
    regional: "Super Chunky / Super Bulky / Roving",
    uses: "Grosses couvertures, cols, accessoires rapides",
  },
  {
    name: "Jumbo",
    regional: "Jumbo / Roving",
    uses: "Tricot avec les bras, texture très marquée, couvertures oversize",
  },
] as const;

const rows = getLocalizedYarnWeightRows(
  yarnWeightCopy,
  "m. / 4 pouces (env. 10 cm)",
);

const faqs = [
  {
    q: "Quelles épaisseurs de fil sont polyvalentes ?",
    a: "Le DK et le worsted sont des points de départ utiles pour les pulls, bonnets, écharpes et couvertures. Choisis le fil selon l’échantillon du modèle et le rendu souhaité.",
  },
  {
    q: "Peut-on remplacer une épaisseur de fil par une autre ?",
    a: "Oui, mais le tombé, le métrage nécessaire et la taille des aiguilles peuvent changer. Tricote un échantillon dans le point du modèle, lave-le et sèche-le comme l’ouvrage fini, puis vérifie les mesures et le rendu. Compare les longueurs de fil plutôt que le nombre de pelotes ; le nombre initial de mailles ne suffit pas à déterminer le nouveau métrage.",
  },
  {
    q: 'Que veut dire "held double" ?',
    a: "Cela veut dire tricoter deux fils ensemble comme s'ils formaient un seul fil plus épais. Deux fils fingering tenus ensemble donnent à peu près un tricot d’une épaisseur proche du DK, mais la fibre, la torsion et le gonflant peuvent rendre le résultat plus léger ou plus lourd. C'est utile quand tu ne trouves pas la bonne épaisseur dans la couleur ou la fibre voulue. Fais un échantillon, parce que le résultat n'est pas entièrement prévisible.",
  },
  {
    q: "Pourquoi mon fil paraît-il plus fin ou plus épais que ce que dit l'étiquette ?",
    a: "Les catégories d’épaisseur couvrent des plages. La fibre, la torsion et la construction influencent l’aspect, et le lavage peut modifier le tricot. Vérifie un échantillon lavé et séché plutôt que de classer le fil d’après son seul aspect.",
  },
];
---

<LocalizedToolPage
  title="Épaisseurs de fil : tableau avec WPI"
  description="Tableau complet des épaisseurs de fil, de lace à jumbo. Consulte l'échantillon, les aiguilles recommandées, le WPI et les projets typiques."
  canonicalPath={routes.tool.yarnWeightChart.fr}
  lang="fr"
  alternates={routes.tool.yarnWeightChart}
  intro="Les catégories principales, avec les plages d'échantillon, de tailles d'aiguilles et de WPI. Ouvre une catégorie pour les détails."
  schemaName="Tableau des épaisseurs de fil"
  schemaDescription="Tableau de référence des épaisseurs de fil avec échantillon, aiguilles recommandées, WPI et types de projets pour les catégories CYC courantes."
  faqs={faqs}
  variant="sand"
>
  <div slot="tool">
    <p>
      Les <a
        href="https://www.craftyarncouncil.com/standards/yarn-weight-system"
        >repères du CYC</a
      > indiquent le nombre de mailles en jersey sur 4 pouces (environ 10 cm) et des
      tailles d’aiguilles pour commencer. La dentelle se tricote souvent avec des
      aiguilles plus grosses pour un résultat ajouré ; suis l’échantillon du modèle.
      Les noms régionaux sont des rapprochements approximatifs, pas des équivalences
      exactes.
    </p>
    <div class="cat-list">
      {
        rows.map((row) => (
          <details class="cat-card">
            <summary class="cat-summary">
              <span class="cat-heading">
                <span>{row[0]}</span>
                <span class="cat-name">{row[1]}</span>
              </span>
              <span class="cat-regional">{row[2]}</span>
              <span class="cat-toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="cat-body">
              <dl class="cat-details">
                <div class="cat-row">
                  <dt>Échantillon</dt>
                  <dd>{row[3]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Aiguilles</dt>
                  <dd>{row[4]}</dd>
                </div>
                <div class="cat-row">
                  <dt>WPI</dt>
                  <dd>{row[5]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Usages courants</dt>
                  <dd>{row[6]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Noms régionaux</dt>
                  <dd>{row[7]}</dd>
                </div>
              </dl>
            </div>
          </details>
        ))
      }
    </div>
    <WpiIdentifier lang="fr" />
  </div>

  <div slot="content">
    <h2>Le problème des noms</h2>
    <p>
      Les noms régionaux peuvent compliquer le choix d’un fil de remplacement.
    </p>

    <h3>Ply ne veut pas dire ce qu'on croit</h3>
    <p>
      "4-ply" dans les modèles britanniques et australiens veut généralement
      dire fingering. Mais ply décrit en réalité la construction du fil, pas son
      épaisseur. Un fil composé de quatre brins très fins peut tout à fait être
      plus fin qu'un fil composé de deux gros brins. Les fils single peuvent
      être bulky. Un 6-ply très retordu peut se retrouver en sport.
    </p>
    <p>
      Pour un ancien modèle, vérifie le fil indiqué et l’échantillon au lieu de
      déduire l’épaisseur du nombre de ply. Les appellations régionales en ply
      sont des conventions, pas toujours le nombre de brins du fil.
    </p>
    <p>Ça piège plus de monde qu'on ne le pense.</p>

    <h3>Worsted et aran : proches, mais pas identiques</h3>
    <p>
      Les deux sont dans la catégorie CYC 4, Medium, mais aran est souvent un
      peu plus épais dans cette plage. Un modèle écrit pour un fil aran à un
      échantillon donné peut devenir trop lâche si tu prends un worsted situé
      sur le bord fin de la catégorie. L'inverse est vrai aussi.
    </p>
    <p>
      Certaines marques utilisent "worsted" et "aran" presque comme synonymes
      sur les étiquettes. D'autres font une vraie différence. L'échantillon
      indiqué sur la bande de pelote est plus fiable que le nom.
    </p>

    <h3>DK, Light Worsted, 8-ply</h3>
    <p>
      DK, pour double knitting, est un terme standard au Royaume-Uni. Les
      modèles américains appellent parfois la même épaisseur "Light Worsted".
      Les modèles australiens et néo-zélandais disent souvent "8-ply". Les trois
      tombent en catégorie CYC 3, Light, mais un DK du côté épais peut
      chevaucher un worsted du côté fin. Les limites de catégories ne sont pas
      des murs.
    </p>

    <h3>Quand les noms régionaux se croisent</h3>
    <p>
      "Sport weight" en Amérique du Nord et "5-ply" dans la terminologie
      australienne se chevauchent, mais ne correspondent pas toujours
      exactement. "Chunky" dans les modèles britanniques veut généralement dire
      CYC 5, Bulky, alors que dans l'usage américain courant, "chunky" peut
      aller de bulky à super bulky.
    </p>
    <p>
      L'approche la plus sûre quand tu passes d'un langage de modèle à un autre
      : ignore complètement le nom et cherche l'échantillon. Si le modèle
      demande 20 mailles pour 10 cm avec des aiguilles 4 mm, c'est cela qu'il
      faut obtenir, peu importe ce que l'étiquette dit du fil.
    </p>

    <h2>Comment fonctionnent les catégories d'épaisseur</h2>
    <p>
      Ici, "weight" ne veut pas dire le poids de la pelote dans la main. Cela
      désigne l'épaisseur du brin. Un fil plus fin donne plus de mailles par 10
      cm. Un fil plus épais, moins.
    </p>
    <p>
      Le système du Craft Yarn Council attribue un numéro et un nom à chaque
      plage d'épaisseur :
    </p>
    <ul>
      <li>
        <strong>0 - Lace.</strong> Fil très fin pour les châles en dentelle et les
        tricots ajourés.
      </li>
      <li>
        <strong>1 - Super Fine.</strong> Territoire fingering et fil à chaussettes.
      </li>
      <li><strong>2 - Fine.</strong> Sport.</li>
      <li>
        <strong>3 - Light.</strong> DK et fils intermédiaires pour vêtements.
      </li>
      <li>
        <strong>4 - Medium.</strong> Worsted et aran. Une plage adaptée à de nombreux
        vêtements et accessoires.
      </li>
      <li><strong>5 - Bulky.</strong> Fils plus épais qui montent vite.</li>
      <li>
        <strong>6 - Super Bulky.</strong> Accessoires rapides, texture très visible.
      </li>
      <li>
        <strong>7 - Jumbo.</strong> L'extrémité la plus épaisse du tableau publié.
      </li>
    </ul>
    <p>
      Cette page couvre les catégories 0 à 7 des tableaux CYC liés, du fil très
      fin Lace au fil très épais Jumbo. Sock et Baby désignent des usages
      courants, pas une épaisseur unique. Les grammes mesurent le poids de la
      pelote et les mètres la longueur du fil ; aucun des deux ne suffit à
      déterminer sa catégorie.
    </p>

    <h2>Identifier l'épaisseur d'un fil sans étiquette</h2>
    <p>
      Les fils sans étiquette apparaissent tout le temps. Quelqu'un donne un sac
      de restes, la bande de pelote a disparu depuis des mois, ou le fil vient
      d'un cône sans étiquette de magasin.
    </p>
    <p>
      Le premier test le plus rapide est le WPI, c'est-à-dire le nombre de tours
      de fil sur 2,54 cm.
    </p>

    <h3>Mesurer le WPI</h3>
    <p>
      Enroule le fil autour d'un crayon, d'une règle ou d'un outil WPI. Garde
      les tours côte à côte, assez serrés, sans étirer ni chevaucher. Compte
      combien tiennent sur 2,54 cm. Le guide CYC utilise ces grandes plages :
    </p>
    <p>
      <a
        href="https://www.craftyarncouncil.com/standards/how-measure-wraps-inch-wpi"
        >guide WPI du CYC</a
      >
    </p>
    <ul>
      <li>30-40+ WPI -&gt; Lace (0)</li>
      <li>14-30 WPI -&gt; Super Fine (1)</li>
      <li>12-18 WPI -&gt; Fine (2)</li>
      <li>11-15 WPI -&gt; Light (3)</li>
      <li>9-12 WPI -&gt; Medium (4)</li>
      <li>6-9 WPI -&gt; Bulky (5)</li>
      <li>5-6 WPI -&gt; Super Bulky (6)</li>
      <li>1-4 WPI -&gt; Jumbo (7)</li>
    </ul>
    <p>
      Remarque les plages qui se chevauchent. Un fil à 12 WPI peut être Fine,
      Light ou Medium selon d'autres facteurs. C'est normal.
    </p>
    <p>
      Si ton fil sort nettement de ces plages, traite le WPI comme un indice,
      pas comme une catégorie définitive.
    </p>

    <h3>Quand le WPI se complique</h3>
    <p>
      Les fils duveteux comme le mohair sont difficiles à enrouler proprement.
      Les singles très gonflants peuvent paraître plus fins qu'ils ne se
      tricotent. Un fil filé main varie sur sa longueur, donc mesure à plusieurs
      endroits et fais une moyenne. Chenille et fils fantaisie texturés ? Bonne
      chance pour obtenir un enroulement net.
    </p>
    <p>
      Le WPI t'amène dans la bonne zone. L'échantillon donne la réponse qui
      compte vraiment. Le <a
        href="/fr/articles/identifier-un-fil-sans-etiquette/"
        >guide pour identifier un fil inconnu</a
      > détaille toute la démarche quand l'étiquette manque complètement.
    </p>

    <h2>Choisir une épaisseur de fil pour un projet</h2>
    <p>
      Les créateurs de modèles choisissent une épaisseur pour obtenir une
      matière, pas seulement pour tricoter vite. Changer d'épaisseur change le
      tombé, la densité, la chaleur et souvent toute l'échelle de l'ouvrage
      fini.
    </p>
    <p>
      Les fils fins (0–2) servent souvent aux chaussettes, châles et jacquards
      détaillés. Le DK et le worsted (3–4) conviennent à de nombreux vêtements,
      bonnets et couvertures ; les fils épais (5–7) peuvent donner de plus
      grandes mailles et des projets plus rapides. Le tombé, la chaleur, la
      définition des mailles et le poids final dépendent aussi de la fibre, de
      la construction, du point et de l’échantillon, pas seulement de
      l’épaisseur.
    </p>
    <p>
      Si tu remplaces par une épaisseur hors de la catégorie d'origine,
      attends-toi à recalculer. Le <a
        href="/fr/articles/remplacer-un-fil-dans-un-modele/"
        >guide de substitution de fil</a
      > explique la méthode. Le <a href={routes.tool.castOnCalculator.fr}
        >calculateur de mailles à monter</a
      > KnitTools aide pour le nombre de mailles, et l'<a
        href={routes.tool.yarnEstimator.fr}>estimateur de quantité de laine</a
      > peut vérifier si le métrage paraît réaliste avant achat.
    </p>

    <h2>Le lien entre épaisseur de fil et taille d'aiguilles</h2>
    <p>
      Les tailles d'aiguilles recommandées sont des points de départ. Pas des
      promesses. Le même DK peut donner un bonnet ferme sur une aiguille et un
      gilet souple sur une autre.
    </p>
    <p>
      C'est là que l'échantillon prend le relais. L'étiquette peut donner une
      direction, mais ton fil, ta tension et ton projet décident de la taille
      d'aiguilles finale.
    </p>
    <p>
      Si tu dois traduire les systèmes de tailles avant de pouvoir faire ton
      échantillon, le <a href={routes.tool.needleSizeChart.fr}
        >tableau des tailles d'aiguilles</a
      > est la page à garder ouverte à côté.
    </p>
  </div>
</LocalizedToolPage>
