          { label: "Homme L", cells: [c("23,5 cm", '9"')] },
        ],
      },
    ],
  },
];

const defaultPanel = "femme";

const faqs = [
  {
    q: "Ces mesures sont-elles les mêmes dans tous les modèles de tricot ?",
    a: "Le CYC publie des tableaux de référence, mais tous les modèles de tricot ne suivent pas le même système de tailles. Les créateurs peuvent utiliser leurs propres mesures et noms de tailles. Consulte toujours le tableau et le schéma de mesures du modèle.",
  },
  {
    q: "Comment choisir une taille si le modèle utilise des numéros au lieu de XS/S/M/L ?",
    a: "Utilise les mesures du modèle, pas seulement le numéro ou la lettre. Vérifie s’il s’agit des mensurations ou des dimensions finies ; pour les dimensions finies, tiens compte de l’aisance prévue. Pour un pull, compare le tour de poitrine et les autres mesures importantes pour la coupe.",
  },
  {
    q: "Faut-il mesurer sur les vêtements ou sur la peau ?",
    a: "Mesure sur la peau ou sur une couche fine et ajustée, en évitant les vêtements épais. Distingue les mensurations des dimensions finies ; l’aisance prévue par le modèle sert à obtenir la coupe souhaitée.",
  },
  {
    q: "Que faire si mes mesures ne rentrent pas proprement dans une seule taille ?",
    a: "C'est normal. La plupart des corps ne correspondent pas à une seule taille pour toutes les mesures. Priorise la mesure la plus importante pour le vêtement : poitrine pour un pull, hanches pour une jupe, tour de tête pour un bonnet. Beaucoup de modèles donnent des instructions pour allonger ou raccourcir certaines parties.",
  },
];
---

<LocalizedToolPage
  title="Tableaux de tailles tricot"
  description="Tableaux de mensurations standard pour le tricot. Tailles bébé à adulte avec poitrine, taille, hanches, bras, en cm et en pouces."
  canonicalPath={routes.tool.knittingSizeCharts.fr}
  lang="fr"
  alternates={routes.tool.knittingSizeCharts}
  intro="Mensurations standard en cm pour chaque projet tricot, avec les valeurs publiées en pouces dans le tableau."
  schemaName="Tableaux de tailles tricot"
  schemaDescription="Tableaux de référence des mensurations standard pour le tricot, des tailles bébé aux tailles adulte."
  faqs={faqs}
  variant="terracotta"
  enableSizeChartControls
>
  <div slot="tool" data-size-chart data-mobile-size-label="Choisir une taille">
    <p class="panel-intro">
      Ce sont des mensurations du corps, pas des mesures du vêtement terminé.
      Ajoute l'aisance nécessaire pour la coupe voulue.
    </p>
    <p class="panel-intro">
      Ces mensurations sont les repères du CYC, pas les dimensions du vêtement
      fini ni des tailles universelles. Les numéros enfant et ado sont des
      tailles de référence américaines, pas des âges ni des tailles européennes
      fondées sur la stature. Les âges bébé sont indicatifs. XS–5XL suivent le
      CYC ; 2XL–5XL correspondent à ses 2X–5X. Mesure la personne et consulte le
      tableau du modèle.
    </p>
    <p class="panel-intro" id="size-source-note">
      Les cm et les pouces reprennent les paires arrondies publiées par le CYC,
      pas des conversions exactes. Six mesures ne disposent pas de valeur de
      source vérifiée, car les valeurs publiées se contredisent. Les deux
      valeurs ont été retirées. Prends les mensurations de la personne selon les
      indications ci-dessous et consulte le guide des tailles et l’aisance
      prévue dans le modèle.
    </p>
    <div class="chart-controls">
      <div class="tab-scroller">
        <div class="tabs" role="tablist" aria-label="Catégorie de taille">
          {
            panels.map((panel) => (
              <button
                type="button"
                role="tab"
                class={`tab-btn${panel.id === defaultPanel ? " is-active" : ""}`}
                data-tab={panel.id}
                aria-selected={panel.id === defaultPanel ? "true" : "false"}
                aria-controls={`panel-${panel.id}`}
                id={`tab-${panel.id}`}
                tabindex={panel.id === defaultPanel ? 0 : -1}
              >
                {panel.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="unit-toggle" role="radiogroup" aria-label="Unité de mesure">
        <button
          type="button"
          role="radio"
          class="unit-btn is-active"
          data-unit="cm"
          tabindex="0"
          aria-checked="true">CM</button
        >
        <button
          type="button"
          role="radio"
          class="unit-btn"
          data-unit="inch"
          tabindex="-1"
          aria-checked="false">Pouces</button
        >
      </div>
    </div>

    <div class="chart-wrap show-cm" id="fr-size-chart-wrap">
      {
        panels.map((panel) => (
          <div
            class={`panel${panel.id === defaultPanel ? " is-active" : ""}`}
            data-panel={panel.id}
            role="tabpanel"
            tabindex="0"
            id={`panel-${panel.id}`}
            aria-labelledby={`tab-${panel.id}`}
            hidden={panel.id !== defaultPanel}
          >
            {panel.intro && <p class="panel-intro">{panel.intro}</p>}
            {panel.tables.map((table) => (
              <div class="table-block">
                {table.caption && (
                  <h3 class="table-caption">{table.caption}</h3>
                )}
                <div class="table-scroll">
                  <table class="size-table">
                    <thead>
                      <tr>
                        <th scope="col" class="sticky-col">
                          {table.sizeHeader ?? "Mesure"}
                        </th>
                        {table.sizes.map((size) => (
                          <th scope="col">{size}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr>
                          <th scope="row" class="sticky-col row-label">
                            {row.label}
                          </th>
                          {row.cells.map((cell) => (
                            <td
                              data-unavailable={cell.cm === null || undefined}
                              aria-describedby={
                                cell.cm === null
                                  ? "size-source-note"
                                  : undefined
                              }
                            >
                              <span class="unit-cm">
                                {formatNumberText(cell.cm ?? unavailableValue)}
                              </span>
                              <span class="unit-inch">
                                {formatNumberText(
                                  cell.inch ?? unavailableValue,
                                )}
                              </span>
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div slot="content">
    <h2>Comment prendre les mensurations</h2>
    <p>
      Les mesures de ces tableaux correspondent à des points précis du corps.
      Pour obtenir une mesure fiable, il faut mesurer au bon endroit.
    </p>
    <p>
      <strong>Poitrine :</strong> Mesure autour de la partie la plus forte de la poitrine,
      avec le mètre ruban horizontal, près du corps mais sans serrer. Pour les femmes,
      c'est au point le plus fort du buste. C'est la mesure principale pour choisir
      une taille de vêtement.
    </p>
    <p>
      <strong>Taille :</strong> Mesure au niveau de la taille naturelle, l'endroit
      le plus étroit du buste, souvent juste au-dessus du nombril. Si tu hésites,
      penche-toi sur le côté ; le pli indique où elle se trouve.
    </p>
    <p>
      <strong>Hanches :</strong> Mesure autour de la partie la plus forte des hanches,
      le mètre ruban horizontal. Repère ce point sur le corps plutôt qu’à une distance
      fixe sous la taille.
    </p>
    <p>
      <strong>Carrure dos :</strong> Mesure droit dans le dos, de l'extrémité d'une
      épaule à l'autre. Cela détermine la largeur d'épaules du vêtement.
    </p>
    <p>
      <strong>Longueur dos jusqu'à la taille :</strong> Mesure depuis l'os visible
      à la base de la nuque jusqu'à la taille naturelle. Cela indique la longueur
      nécessaire du buste.
    </p>
    <p>
      <strong>Longueur dos jusqu’aux hanches (homme) :</strong> Le tableau homme suit
      le PDF du CYC : la mesure va de la nuque aux hanches, pas à la taille. Vérifie
      ce point d’arrivée sur le schéma du modèle.
    </p>
    <p>
      <strong>Longueur du bras : aisselle au poignet :</strong> Mesure de l’aisselle
      au poignet, le bras légèrement plié. C’est un repère corporel pour la manche,
      pas sa longueur finie.
    </p>
    <p>
      <strong>Tour de haut de bras :</strong> Mesure le tour de la partie la plus
      forte du haut du bras, bras détendu le long du corps.
    </p>
    <p>
      <strong>Profondeur d’emmanchure :</strong> Mesure verticalement du bord supérieur
      externe de l’épaule jusqu’à l’aisselle.
    </p>
    <p>
      <strong>Nuque à poignet milieu dos :</strong> Garde le bras droit et mesure
      depuis la base de la nuque au milieu du dos, en passant sur l’épaule puis le
      long du bras jusqu’au poignet.
    </p>
    <p>
      <strong>Accessoires :</strong> Mesure le tour de tête en passant sur le front
      et autour de toute la tête, la longueur du pied au sol de l’arrière du talon
      au bout de l’orteil le plus long, et le tour de la paume de la main dominante
      juste sous les articulations des doigts, sans le pouce. Ce sont des mensurations,
      pas les dimensions finies du bonnet, de la chaussette ou de la moufle. La longueur
      du pied n’est pas une conversion de pointure et ne suffit pas seule pour dimensionner
      une chaussette. Les âges sont indicatifs.
    </p>

    <h2>Mensurations ou mesures du vêtement fini</h2>
    <p>
      Ces tableaux montrent des mensurations. Le vêtement fini peut être plus
      petit, de même taille ou plus grand selon l’aisance prévue par le modèle.
    </p>
    <p>
      <strong>Aisance négative :</strong> Le vêtement est plus petit que le corps.
      Pour un pull très ajusté, le CYC propose environ 5–10 cm de moins que le tour
      de poitrine. Les bonnets et chaussettes suivent les recommandations propres
      à leur modèle.
    </p>
    <p>
      <strong>Aisance nulle :</strong> La mesure du vêtement fini est égale à la mensuration
      correspondante.
    </p>
    <p>
      <strong>Aisance positive :</strong> Le vêtement est plus grand que le corps.
      Le CYC propose environ 5–10 cm de plus au tour de poitrine pour une coupe de
      pull classique, pas comme règle pour tous les modèles.
    </p>
    <p>
      <strong>Coupe ample ou oversize :</strong> Le CYC propose environ 10–15 cm de
      plus au tour de poitrine pour un pull ample, et au moins 15 cm pour un pull
      oversize.
    </p>
    <p>
      Si un modèle destiné à un tour de poitrine de 91,5 cm mesure 101,5 cm une
      fois terminé, l’aisance positive est de 10 cm. Compare à la fois les
      mensurations indiquées et les dimensions finies du schéma à la coupe
      souhaitée.
    </p>
    <p>
      Une fois la taille cible choisie, l'<a href={routes.tool.yarnEstimator.fr}
        >estimateur de quantité de laine</a
      > peut vérifier si le métrage est cohérent, et le <a
        href="/fr/articles/combien-de-fil-pour-un-pull/"
        >guide du fil pour pull</a
      > détaille les calculs de taille.
    </p>

    <h2>Choisir entre deux tailles</h2>
    <p>
      Entre deux tailles, compare les dimensions finies à tes mensurations et à
      l’aisance prévue. Ne choisis pas automatiquement plus petit pour une coupe
      ajustée ou plus grand pour une coupe oversize. Le point, la fibre et
      l’échantillon lavé puis séché influencent l’élasticité et le tomber.
      Bonnets et chaussettes ont leurs propres recommandations ; une valeur fixe
      ne garantit pas la bonne taille.
    </p>
    <p>
      Compare aussi les autres mesures, surtout les hanches pour les vêtements
      longs et le haut de bras pour les manches ajustées. Si la poitrine dit M
      mais les hanches disent L, regarde le schéma de mesures du modèle pour
      voir si la différence aux hanches compte pour la longueur et la
      silhouette.
    </p>
    <p>
      Quelle que soit la taille choisie, l'<a
        href="/fr/articles/tricoter-un-echantillon-etape-par-etape/"
        >échantillon</a
      > décide si l'ouvrage fini correspond réellement aux chiffres du modèle. Le
      guide <a href="/fr/articles/mesurer-un-echantillon-tricot/"
        >mesurer l'échantillon</a
      > explique la méthode en détail.
    </p>

    <h2>Sources et conventions de mesure</h2>
    <p>
      <a href="https://www.craftyarncouncil.com/standards/body-sizing"
        >Craft Yarn Council: Sources et conventions de mesure</a
      >. <a href="https://www.craftyarncouncil.com/standards/baby-size-chart"
        >Bébé</a
      >, <a href="https://www.craftyarncouncil.com/standards/child-youth-sizes"
        >Enfant et ado</a
      >, <a href="https://www.craftyarncouncil.com/standards/woman-size"
        >Femme</a
      >, <a href="https://www.craftyarncouncil.com/standards/man-size">Homme</a
      >, <a
        href="https://www.craftyarncouncil.com/standards/head-circumference-chart"
        >Tête</a
      >, <a href="https://www.craftyarncouncil.com/standards/foot-size-charts"
        >Pied</a
      >, <a href="https://www.craftyarncouncil.com/standards/hand-size-charts"
        >Main</a
      >. <a
        href="https://media.craftyarncouncil.com/sites/default/files/images/standards/CYC_YarnStandards-2018-11-06.pdf"
        >CYC PDF</a
      >.
    </p>
    <p>
      Source : Craft Yarn Council. Le PDF lié (pages 17–18) clarifie deux
      erreurs des tableaux web : le tour de bras femme 5XL est de 19,5 pouces,
      et la longueur dos homme va jusqu’aux hanches, pas à la taille. Les six
      autres incohérences de la source restent non résolues. Ce site retire les
      valeurs dans les deux unités pour ces mesures, sans les remplacer par des
      valeurs corrigées ou calculées.
    </p>
  </div>
</LocalizedToolPage>
