---
import PageLayout from "../layouts/PageLayout.astro";
import ClosingCTA from "../components/ClosingCTA.astro";
import {
  CONTACT_MAILTO,
  FINNVEK_URL,
  ORGANIZATION_ID,
  SOCIAL_PROFILE_URLS,
  SOFTWARE_APPLICATION_ID,
  SITE_URL,
} from "../config/brand";

const aboutDescription =
  "Meet Emma Hotakainen, the independent developer behind KnitTools, and learn how a gift grew into an Android app for knitting and crochet.";
const aboutJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORGANIZATION_ID,
      name: "Finnvek",
      url: FINNVEK_URL,
      email: CONTACT_MAILTO,
      sameAs: SOCIAL_PROFILE_URLS,
    },
    {
      "@type": "SoftwareApplication",
      "@id": SOFTWARE_APPLICATION_ID,
      name: "KnitTools",
      url: `${SITE_URL}/`,
      operatingSystem: "Android",
      applicationCategory: "LifestyleApplication",
      publisher: {
        "@id": ORGANIZATION_ID,
      },
    },
    {
      "@type": "AboutPage",
      "@id": `${SITE_URL}/about/#webpage`,
      url: `${SITE_URL}/about/`,
      name: "About KnitTools",
      description: aboutDescription,
      inLanguage: "en",
      about: [
        {
          "@id": SOFTWARE_APPLICATION_ID,
        },
        {
          "@id": ORGANIZATION_ID,
        },
      ],
      publisher: {
        "@id": ORGANIZATION_ID,
      },
      mainEntity: {
        "@id": SOFTWARE_APPLICATION_ID,
      },
      breadcrumb: {
        "@id": `${SITE_URL}/about/#breadcrumb`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${SITE_URL}/about/#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "About",
          item: `${SITE_URL}/about/`,
        },
      ],
    },
  ],
};
---

<PageLayout
  title="About KnitTools"
  description={aboutDescription}
  canonicalPath="/about/"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(aboutJsonLd)}
  />

  <section class="about-header" aria-labelledby="about-heading">
    <div class="about-header-inner">
      <h1 id="about-heading">About KnitTools</h1>
      <p class="about-intro">
        Hi, I’m Emma Hotakainen, an independent developer from Turku, Finland. I
        build apps under the name Finnvek. I can’t knit.
      </p>
    </div>
  </section>

  <section class="about-body">
    <div class="about-body-inner">
      <div class="about-copy">
        <p>
          The knitter in our house is my wife. She’s the kind of knitter who
          keeps everything in her hands and her head. She doesn’t count rows,
          doesn’t lose her place and has never wanted a knitting app. So
          naturally, I decided to build her one.
        </p>
        <p>
          KnitTools started as a gift. I wanted to make her something, and the
          thing I know how to make is software. What began as a knitting app
          grew to include crochet too. Today, it brings counters, project notes,
          yarn details and patterns together for knitters and crocheters who
          appreciate a little help keeping track.
        </p>
        <p>
          I design, build and test the app myself. Let’s see when I’m happy
          enough with it to finally release it. I keep finding little details I
          want to get right.
        </p>
        <p>
          <a href="https://finnvek.com"
            >More about me and my other apps</a
          >
        </p>
      </div>
    </div>
  </section>
  <ClosingCTA variant="page" />
</PageLayout>

<style>
  .about-header {
    color: var(--ink);
    padding: 60px 40px 40px;
    border-bottom: 1px solid var(--ink);
  }

  .about-header-inner,
  .about-body-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-transform: none;
    max-width: 760px;
    margin: 0 0 20px;
    padding-bottom: 0.08em;
  }

  .about-intro {
    font-family: var(--body-ed);
    font-weight: 400;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--ink);
    max-width: 620px;
    line-height: 1.55;
    margin: 0;
  }

  .about-body {
    padding: 56px 40px 100px;
  }

  .about-copy {
    max-width: 720px;
    display: grid;
    gap: 20px;
    font-family: var(--body-ed);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  @media (max-width: 767px) {
    .about-header {
      padding: 40px 20px 32px;
    }

    .about-body {
      padding: 40px 20px 72px;
    }
  }
</style>
