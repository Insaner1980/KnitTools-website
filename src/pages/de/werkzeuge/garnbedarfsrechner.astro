---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import YarnEstimator from "../../../components/YarnEstimator.astro";
import { routes } from "../../../i18n/routes";

import { yarnReferenceCopy } from "../../../i18n/yarnReference";
const referenceCopy = yarnReferenceCopy.de;

const faqs = [
  { q: referenceCopy.methodTitle, a: referenceCopy.method },
  { q: referenceCopy.adviceTitle, a: referenceCopy.advice },
];
---

<LocalizedToolPage
  title="Garnbedarfsrechner: Wie viel Garn brauche ich?"
  description={referenceCopy.description}
  canonicalPath={routes.tool.yarnEstimator.de}
  lang="de"
  alternates={routes.tool.yarnEstimator}
  intro={referenceCopy.intro}
  schemaName="Garnbedarfsrechner"
  schemaDescription={referenceCopy.description}
  faqs={faqs}
  variant="rust"
>
  <div slot="tool">
    <YarnEstimator lang="de" />
  </div>

  <div slot="content">
    <h2>{referenceCopy.methodTitle}</h2><p>{referenceCopy.method}</p><p>
      {referenceCopy.limitations}
    </p>
  </div>
</LocalizedToolPage>
