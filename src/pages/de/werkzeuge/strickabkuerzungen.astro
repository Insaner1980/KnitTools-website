const filterOrder: Array<Category | "all"> = [
  "all",
  "cast-on-bind-off",
  "increases",
  "decreases",
  "cables",
  "lace",
  "general",
  "stitch-patterns",
];

const faqs = [
  {
    q: "Sind Strickabkürzungen in US- und UK-Anleitungen gleich?",
    a: 'Die meisten sind identisch. k, p, yo und k2tog bedeuten auf beiden Seiten des Atlantiks dasselbe. Unterschiede gibt es bei einzelnen Begriffen: US "bind off" ist UK "cast off", US "gauge" ist UK "tension" und US "stockinette" ist UK "stocking stitch". Außerdem können "seed stitch" und "moss stitch" je nach Quelle vertauscht werden. Vertraue deshalb der Maschendefinition mehr als dem Namen.',
  },
  {
    q: "Was bedeutet ein Stern in einer Strickanleitung?",
    a: "Ein Stern markiert den Anfang einer Wiederholung. Wiederhole die markierte Folge so oft oder bis zu dem Punkt, den die Anleitung nennt. Runde und eckige Klammern können auch Größenangaben oder mehrere Schritte in dieselbe Masche kennzeichnen. Lies die zugehörige Anweisung.",
  },
  {
    q: "Was mache ich bei einer unbekannten Abkürzung?",
    a: "Es kann eine Kurzform sein, die nur in dieser Anleitung definiert ist. Prüfe Abkürzungsliste, Technikbeschreibungen, Hinweise und Strickschriftlegende. Frage bei Unklarheiten die Designerin oder den Designer, bevor du eine Technik ersetzt.",
  },
  {
    q: "Was ist der Unterschied zwischen ssk und skp?",
