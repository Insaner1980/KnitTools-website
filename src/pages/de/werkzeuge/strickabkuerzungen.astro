    search: "cast on maschen anschlagen anschlag",
    categories: ["cast-on-bind-off"],
  },
  {
    abbr: "BO",
    def: "abketten (bind off US / cast off UK)",
    search: "bind off cast off abketten abkettkante",
    categories: ["cast-on-bind-off"],
  },

  {
    abbr: "k",
    def: "rechte Masche stricken (knit)",
    search: "knit rechte masche rechts stricken",
    categories: ["general"],
  },
  {
    abbr: "p",
    def: "linke Masche stricken (purl)",
    search: "purl linke masche links stricken",
    categories: ["general"],
  },
  {
    abbr: "st(s)",
