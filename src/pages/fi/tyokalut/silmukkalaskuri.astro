---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import CastOnCalculator from "../../../components/CastOnCalculator.astro";
import { routes } from "../../../i18n/routes";

const faqs = [
  {
    q: "Pitääkö mallitilkku oikeasti neuloa?",
    a: "Kyllä, jos työn koolla on väliä. Mallitilkku kertoo oman neuletiheytesi sillä langalla, puikolla ja neulepinnalla, jota aiot käyttää.",
  },
  {
    q: "Lasketaanko reunasilmukat mukaan neuletiheyteen?",
    a: "Ei yleensä. Mittaa mallitilkun keskeltä, ei heti luomisreunasta tai sivureunasta. Reunat ovat helposti muuta neuletta tiukempia tai löysempiä.",
  },
  {
    q: "Miksi laskuri pyöristää parilliseen silmukkamäärään?",
    a: "Parillisuus on laskurin pyöristyssääntö, ei tae mallineuleen sopivuudesta. Joustin, palmikot ja muut mallineuleet voivat vaatia tietyn mallikerran sekä lisäsilmukoita.",
  },
  {
    q: "Mitä jos ohje vaatii tietyn silmukkajaon?",
    a: "Jos mallikerta on neljä silmukkaa eikä lisäsilmukoita tarvita, säädä tulos 46 silmukasta 44:ään tai 48:aan. Huomioi ohjeen reuna- ja muut lisäsilmukat sekä muutoksen vaikutus leveyteen.",
  },
  {
    q: "Voiko tätä käyttää suljettuun neuleeseen?",
    a: "Voi. Mittaa neuletiheys suljettuna neulotusta mallitilkusta ja syötä haluttu valmiin työn ympärysmitta leveydeksi. Huomioi haluttu väljyys jo mitassa: laskuri ei lisää eikä vähennä väljyyttä.",
  },
];
---

<LocalizedToolPage
  lang="fi"
  title="Silmukkalaskuri neuletiheydellä"
  description="Laske, montako silmukkaa pitää luoda haluttuun leveyteen oman neuletiheyden perusteella. Sopii paitoihin, huiveihin ja peittoihin."
  canonicalPath={routes.tool.castOnCalculator.fi}
  alternates={routes.tool.castOnCalculator}
  intro="Syötä neuletiheys ja haluttu leveys. Laskuri kertoo, montako silmukkaa kannattaa luoda."
  schemaName="Silmukkalaskuri"
  schemaDescription="Laskee luotavien silmukoiden määrän neuletiheyden ja halutun leveyden perusteella."
  faqs={faqs}
>
  <div slot="tool">
    <CastOnCalculator lang="fi" />
  </div>

  <div slot="content">
    <h2>Mitä silmukoiden luominen tarkoittaa?</h2>
    <p>
      Silmukoiden luomisessa tehdään neuleen aloitussilmukat. Siinä tehdään
      puikolle ne silmukat, joista työ lähtee kasvamaan. Määrä ja neuletiheys
      ratkaisevat aloitusleveyden. Liian vähän silmukoita, ja kappaleesta tulee
      kapea. Liian paljon, ja työ alkaa väärässä koossa jo ennen ensimmäistä
      varsinaista kerrosta.
    </p>

    <h2>Miksi neuletiheys ratkaisee</h2>
    <p>
      Sama lanka ja sama puikkokoko eivät tuota kaikille samaa neulepintaa. Yksi
      neuloo tiukasti, toinen rennommin. Siksi ohjeen neuletiheys on lähtökohta,
      ei lupaus. Neulo mallitilkku, kastele tai viimeistele se samalla tavalla
      kuin valmis työ. Mittaa kuivuneen tilkun keskeltä silmukat 10 cm matkalta.
    </p>

    <h2>Näin käytät laskuria</h2>
    <p>
      Tarvitset kaksi lukua: neuletiheyden eli montako silmukkaa saat 10 cm tai
      4 tuuman matkalle, sekä halutun leveyden. Jos neulot esimerkiksi 20
      silmukkaa / 10 cm ja tarvitset 50 cm leveän kappaleen, lasku antaa 100
      silmukkaa. Sen jälkeen tarkistetaan vielä ohjeen silmukkajako.
    </p>

    <p>
      Jos reunaan tulee joustinneule, palmikko tai pitsikuvio, mittaa
      neuletiheys kyseisessä mallineuleessa. Lopullinen silmukkamäärä voi vaatia
      säädön. Laskuri antaa järkevän lähtöpisteen. Ohjeen toisto kertoo
      viimeisen sanan.
    </p>
    <p>
      Valitse cm, kun leveys on senttimetreinä ja neuletiheys on mitattu 10 cm
      matkalta. Valitse tuumat, kun leveys on tuumina ja neuletiheys on mitattu
      4 tuuman matkalta. Nämä ovat tavanomaisia mittausvälejä, eivät tarkkoja
      vastineita: 4 tuumaa on 10,16 cm. Yksikön vaihto ei muunna syötettyjä
      lukuja. Kaava on neuletiheys × leveys ÷ 10 senttimetreillä tai ÷ 4
      tuumilla.
    </p>

    <p>
      Tulos pyöristetään lähimpään parilliseen lukuun; tasatilanteessa ylöspäin.
      Esimerkiksi 99 pyöristyy 100:aan. Hyvin pieni leveys voi antaa
      pyöristyksen jälkeen 0 silmukkaa, joka ei ole käyttökelpoinen
      aloitusmäärä. Tarkista mitat ja ohje ennen silmukoiden luomista.
    </p>
  </div>
</LocalizedToolPage>
