---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import WpiIdentifier from "../../../components/WpiIdentifier.astro";
import { routes } from "../../../i18n/routes";
import { getLocalizedYarnWeightRows } from "../../../lib/toolReferenceData";

const yarnWeightCopy = [
  {
    name: "Lace",
    regional: "Cobweb / Light fingering / 2-ply",
    uses: "Pitsihuivit, liinat ja hyvin ohuet pitsineuleet",
  },
  {
    name: "Super Fine",
    regional: "Sock / Fingering / Baby / 4-ply",
    uses: "Sukat, vauvanneuleet, hienot huivit ja kevyet vaatteet",
  },
  {
    name: "Fine",
    regional: "Sport / Baby / 5-ply",
    uses: "Kevyet vaatteet, vauvanvaatteet ja asusteet",
  },
  {
    name: "Light",
    regional: "DK / Light Worsted / 8-ply",
    uses: "Neulepaidat, pipot, huivit, vauvanpeitot ja ympärivuotiset vaatteet",
  },
  {
    name: "Medium",
    regional: "Worsted / Aran / Afghan / 10-ply",
    uses: "Neulepaidat, pipot, lapaset, peitot ja useimmat arkiset neuleet",
  },
  {
    name: "Bulky",
    regional: "Chunky / Craft / Rug / 12-ply",
    uses: "Paksut paidat, huivit, peitot ja nopeat työt",
  },
  {
    name: "Super Bulky",
    regional: "Super Chunky / Super Bulky / Roving",
    uses: "Paksut peitot, kaulurit ja nopeasti valmistuvat asusteet",
  },
  {
    name: "Jumbo",
    regional: "Jumbo / Roving",
    uses: "Käsivarsineulonta, näyttävä neulepinta ja erittäin paksut peitot",
  },
] as const;

const rows = getLocalizedYarnWeightRows(
  yarnWeightCopy,
  "s / 4 in (noin 10 cm)",
);

const faqs = [
  {
    q: "Mitkä lankavahvuudet ovat monikäyttöisiä?",
    a: "DK ja worsted sopivat monenlaisiin paitoihin, pipoihin, huiveihin ja peittoihin. Valitse lanka ohjeen neuletiheyden ja haluamasi neulepinnan mukaan.",
  },
  {
    q: "Voiko yhden lankavahvuuden korvata toisella?",
    a: "Voi, mutta neuletiheys, laskeutuvuus ja menekki voivat muuttua. Neulo mallitilkku ohjeen mallineuleella, pese ja kuivaa se kuten valmis työ ja tarkista tiheys sekä neulepinta. Vertaa lankojen metrimääriä kerämäärien sijaan. Pelkkä alkuperäinen silmukkamäärä ei kerro uuden langan menekkiä.",
  },
  {
    q: "Mitä kaksinkertaisena neulominen tarkoittaa?",
    a: "Kaksi lankaa neulotaan yhdessä kuin yksi paksumpi lanka. Kaksi fingering-lankaa voi lähestyä DK-vahvuutta, mutta kuitu, kierre ja ilmavuus vaikuttavat paljon. Varmista tulos pestyllä ja kuivatulla mallitilkulla.",
  },
  {
    q: "Miksi lanka näyttää ohuemmalta tai paksummalta kuin vyöte sanoo?",
    a: "Lankavahvuudet ovat alueita. Kuitu, kierre ja rakenne vaikuttavat ulkonäköön, ja pesu voi muuttaa neulepintaa. Tarkista pesty ja kuivattu mallitilkku sen sijaan, että määrittäisit vahvuuden pelkän ulkonäön perusteella.",
  },
];
---

<LocalizedToolPage
  lang="fi"
  title="Lankavahvuudet: WPI, puikot ja neuletiheys"
  description="Lankavahvuustaulukko neuletiheyksillä, puikkosuosituksilla, WPI-arvoilla ja tavallisilla käyttökohteilla."
  canonicalPath={routes.tool.yarnWeightChart.fi}
  alternates={routes.tool.yarnWeightChart}
  intro="Vertaa lankavahvuuksia ja tarkista, mihin neuletiheyteen ja puikkokokoon ne yleensä asettuvat."
  schemaName="Lankavahvuustaulukko"
  schemaDescription="Lankavahvuuksien taulukko neuletiheyksillä, puikkosuosituksilla ja WPI-arvoilla."
  faqs={faqs}
  variant="sand"
>
  <div slot="tool">
    <p>
      <a href="https://www.craftyarncouncil.com/standards/yarn-weight-system"
        >CYC:n suuntaa-antavat arvot</a
      > koskevat sileän neuleen silmukkamäärää 4 tuumalla (noin 10 cm) ja puikkojen
      aloituskokoa. Pitsineuletta tehdään usein suuremmilla puikoilla: noudata ohjeen
      neuletiheyttä. Alueelliset nimet ovat likimääräisiä vastineita, eivät tarkkoja
      muunnoksia.
    </p>
    <div class="cat-list">
      {
        rows.map((row) => (
          <details class="cat-card">
            <summary class="cat-summary">
              <span class="cat-heading">
                <span>{row[0]}</span>
                <span class="cat-name">{row[1]}</span>
              </span>
              <span class="cat-regional">{row[2]}</span>
              <span class="cat-toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="cat-body">
              <dl class="cat-details">
                <div class="cat-row">
                  <dt>Neuletiheys</dt>
                  <dd>{row[3]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Puikot</dt>
                  <dd>{row[4]}</dd>
                </div>
                <div class="cat-row">
                  <dt>WPI</dt>
                  <dd>{row[5]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Käyttö</dt>
                  <dd>{row[6]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Alueelliset nimet</dt>
                  <dd>{row[7]}</dd>
                </div>
              </dl>
            </div>
          </details>
        ))
      }
    </div>
    <WpiIdentifier lang="fi" />
  </div>

  <div slot="content">
    <h2>Nimet menevät helposti sekaisin</h2>
    <p>
      Lankavahvuus ei ole sama asia kuin kerän paino. Se kertoo langan
      paksuudesta. Nimet eivät kuitenkaan ole täydellisen siistejä lokeroita.
      Sama lanka voi olla yhdessä maassa DK, toisessa 8-ply ja kolmannessa light
      worsted.
    </p>

    <h3>Ply ei tarkoita sitä, mitä moni luulee</h3>
    <p>
      Ply voi tarkoittaa säikeiden määrää. Lankojen nimissä se on usein
      alueellinen vahvuusnimi. Nelisäikeinen lanka ei automaattisesti ole
      4-ply-vahvuutta, ja yksisäikeinen lanka voi olla hyvinkin paksu.
    </p>

    <h3>Worsted ja aran ovat lähellä, mutta eivät sama asia</h3>
    <p>
      Worsted ja aran osuvat usein samaan keskivahvaan alueeseen, mutta aran on
      monissa ohjeissa hiukan paksumpi. Jos vaihdat niiden välillä, tarkista
      neuletiheys ennen kuin aloitat vaatteen.
    </p>

    <h3>DK, light worsted ja 8-ply</h3>
    <p>
      Nämä voivat kuvata suunnilleen samaa vahvuutta, mutta rajat menevät
      päällekkäin. Siksi vyötteen neuletiheys ja oma mallitilkku ovat
      luotettavampia kuin nimi yksin.
    </p>

    <h3>Kun alueelliset nimet törmäävät</h3>
    <p>
      US-, UK-, Australian ja eurooppalaiset nimet eivät aina osu yksi yhteen.
      Jos ohje ja lanka tulevat eri järjestelmistä, vertaa millimetrejä,
      neuletiheyttä ja metrejä, älä vain nimeä.
    </p>

    <h2>Miten lankavahvuuskategoriat toimivat</h2>
    <p>
      Tämä sivu kattaa linkitettyjen CYC-taulukoiden luokat 0–7: Lace on
      pitsiohut ja Jumbo erittäin paksu lanka. Sock ja Baby kertovat
      tavallisesta käyttökohteesta, eivät yhdestä lankavahvuudesta. Kerän paino
      grammoina ja langan pituus metreinä ovat eri tietoja; kumpikaan ei yksin
      määritä lankavahvuutta.
    </p>

    <p>
      Alueet menevät päällekkäin tarkoituksella. Kierre, kuitu ja viimeistely
      vaikuttavat siihen, miltä lanka tuntuu puikolla ja millainen neulepinta
      siitä syntyy.
    </p>

    <h2>WPI auttaa, kun vyöte puuttuu</h2>
    <p>Nopein ensimmäinen tarkistus on WPI-mittaus.</p>

    <h3>WPI:n mittaaminen</h3>
    <p>
      Kierrä lanka kynän, viivaimen tai WPI-mitan ympärille. Kierrosten pitää
      olla vierekkäin, ei päällekkäin, eikä lankaa saa venyttää. Laske, montako
      kierrosta mahtuu 2,54 cm matkalle. CYC käyttää näitä väljiä alueita:
    </p>

    <p>
      <a
        href="https://www.craftyarncouncil.com/standards/how-measure-wraps-inch-wpi"
        >CYC:n WPI-ohje</a
      >
    </p>
    <ul>
      <li>30-40+ WPI -&gt; Lace (0)</li>
      <li>14-30 WPI -&gt; Super Fine (1)</li>
      <li>12-18 WPI -&gt; Fine (2)</li>
      <li>11-15 WPI -&gt; Light (3)</li>
      <li>9-12 WPI -&gt; Medium (4)</li>
      <li>6-9 WPI -&gt; Bulky (5)</li>
      <li>5-6 WPI -&gt; Super Bulky (6)</li>
      <li>1-4 WPI -&gt; Jumbo (7)</li>
    </ul>

    <p>
      Huomaa päällekkäisyydet. Lanka, jonka WPI on 12, voi osua Fine-, Light-
      tai Medium-alueelle muista ominaisuuksista riippuen. Se on normaalia.
    </p>

    <h3>Milloin WPI on hankala</h3>
    <p>
      Pörröinen, löyhästi kierretty tai litteä nauhalanka voi näyttää
      WPI-mittauksessa eri vahvuiselta kuin se käyttäytyy neuleessa. Paksu
      mohair voi neuloutua ilmavaksi. Tiivis puuvilla voi käyttäytyä raskaammin
      kuin luku antaa ymmärtää.
    </p>

    <p>
      WPI kertoo lähialueen. Mallitilkku kertoo vastauksen, jolla on väliä. Jos
      vyöte puuttuu kokonaan, katso myös kuitu, paino, tuntuma ja valmis
      mallitilkku ennen kuin sitoudut isoon projektiin.
    </p>

    <h2>Lankavahvuuden valinta projektiin</h2>
    <p>
      Ohuita lankoja käytetään usein sukkiin, huiveihin ja yksityiskohtaiseen
      kirjoneuleeseen. DK ja worsted sopivat monenlaisiin vaatteisiin ja
      peittoihin. Paksulla langalla työ voi edetä nopeasti. Laskeutuvuus,
      lämpimyys, silmukoiden erottuvuus ja valmiin työn paino riippuvat myös
      kuidusta, rakenteesta, mallineuleesta ja neuletiheydestä, eivät vain
      lankavahvuudesta.
    </p>

    <h2>Lankavahvuus ja puikkokoko kuuluvat yhteen</h2>
    <p>
      Puikkosuositus on lähtöpiste. Sama worsted-lanka voi toimia 4,5 mm
      puikoilla napakkana lapasena ja 5,5 mm puikoilla pehmeämpänä huivina.
      Puikko ei yksin määritä vahvuutta, mutta se muuttaa neulepinnan tiheyttä,
      laskeutuvuutta ja menekkiä.
    </p>
  </div>
</LocalizedToolPage>
