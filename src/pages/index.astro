---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import PullQuote from "../components/PullQuote.astro";
import NineTools from "../components/NineTools.astro";
import FreeToolsCallout from "../components/FreeToolsCallout.astro";
import TrustSection from "../components/TrustSection.astro";
import PricingCards from "../components/PricingCards.astro";
import HomeFaq from "../components/HomeFaq.astro";
import YarnPath from "../components/YarnPath.astro";
import {
  PRICING,
  getLaunchPhase,
  getPricePhase,
  getStructuredOffers,
} from "../config/pricing";
import {
  CONTACT_MAILTO,
  FINNVEK_URL,
  ORGANIZATION_ID,
  SOCIAL_PROFILE_URLS,
  SOFTWARE_APPLICATION_ID,
  SITE_URL,
} from "../config/brand";

const phase = getLaunchPhase(
  Date.now(),
  PRICING.launchStartMs,
  PRICING.launchEndMs,
);
const structuredOffers = getStructuredOffers(getPricePhase(phase));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORGANIZATION_ID,
      name: "Finnvek",
      url: FINNVEK_URL,
      email: CONTACT_MAILTO,
      sameAs: SOCIAL_PROFILE_URLS,
    },
    {
      "@type": "SoftwareApplication",
      "@id": SOFTWARE_APPLICATION_ID,
      name: "KnitTools",
      url: `${SITE_URL}/`,
      operatingSystem: "Android",
      applicationCategory: "LifestyleApplication",
      publisher: {
        "@id": ORGANIZATION_ID,
      },
      description:
        "An all-in-one knitting and crochet project toolkit for Android. Row and round counter, pattern viewer, four calculators, Ravelry integration, project notes, progress photos, project stats, and a home-screen counter widget. One-time purchase, no subscription.",
      offers: structuredOffers,
      inLanguage: [
        "en",
        "fi",
        "sv",
        "da",
        "nb",
        "nl",
        "de",
        "fr",
        "it",
        "pt",
        "pt-BR",
        "es",
      ],
    },
  ],
};
---

<PageLayout
  title="KnitTools: Knitting and Crochet Projects on Android"
  browserTitle="KnitTools: Knitting and Crochet Projects on Android"
  description="KnitTools is an Android app for knitting and crochet projects with row and round counters, patterns, yarn, notes, photos, stats, Ravelry and a 14-day trial."
  canonicalPath="/"
  enableRevealAnimations
  preloadDisplayFont={false}
>
  <script
    is:inline
    type="application/ld+json"
    data-pricing-schema
    data-launch-offers={JSON.stringify(getStructuredOffers("launch"))}
    data-permanent-offers={JSON.stringify(getStructuredOffers("permanent"))}
    set:html={JSON.stringify(jsonLd)}
  />

  <Hero phase={phase} />
  <Marquee />
  <YarnPath />
  <NineTools phase={phase} />
  <FreeToolsCallout />
  <TrustSection phase={phase} />
  <YarnPath flip />
  <PullQuote
    quote="Everything your project needs, together in one app. One price, no subscription."
  />
  <PricingCards phase={phase} />
  <HomeFaq phase={phase} />
</PageLayout>
