  {
    q: "Should I measure over clothing or on bare skin?",
    a: "Measure over bare skin or a thin fitted layer, and avoid bulky clothing. A heavy sweater adds inches that don't reflect the body measurement the pattern size chart is asking for.",
  },
  {
    q: "What if my measurements don't fit neatly into one size?",
    a: "Normal. Most people aren't a single size across all measurements. Prioritize the measurement most important for the garment: chest for a sweater, hips for a skirt, head circumference for a hat. Many patterns include instructions for lengthening or shortening specific sections.",
  },
];
---

<PageLayout
  contentPage
  title="Knitting Size Charts for Body Measurements"
  description="Standard body measurement charts for knitting. Baby through adult sizes with chest, waist, hips, arm length, and more, in cm and inches."
  canonicalPath="/tools/knitting-size-charts/"
  alternates={routes.tool.knittingSizeCharts}
  enableRevealAnimations
>
  <ToolStructuredData
    name="Knitting Size Charts"
    description="Standard body measurement reference charts for knitting, from baby through adult sizes."
    canonicalPath="/tools/knitting-size-charts/"
    faqs={faqs}
  />

  <!-- 1. Tool hero -->
  <section class="tool-hero">
    <div class="hero-inner">
      <p class="eyebrow">
        <a href="/tools/" class="eyebrow-back">← All tools</a>
      </p>
      <h1 data-reveal="heading" aria-label="Knitting Size Charts">
        Knitting Size Charts
      </h1>
      <p class="hero-intro" data-reveal>
        Body measurements for common knitting projects. Pick a category and unit
        to see the chart.
      </p>
      <p class="hero-note" data-reveal>
        These are body measurements, not finished garment measurements. Use the
        pattern’s intended ease for the fit you want.
      </p>

      <div
        class="form-card variant-terracotta is-wide"
        data-reveal="scale"
        data-size-chart
        data-mobile-size-label="Choose size"
      >
        <p class="panel-intro">
          These are CYC body references, not finished garment dimensions or
          universal sizes. Child/youth numbers are US reference sizes, not ages
          or European height sizes. Baby ages are approximate. XS–5XL follow
          CYC; 2XL–5XL mean its 2X–5X. Measure the wearer and use the pattern’s
          own sizing.
        </p>
        <p class="panel-intro" id="size-source-note">
          CM and inches show CYC’s published, rounded pairs, not exact
          conversions. Six measurements are unavailable from a verified source
          because the published values conflict. Both numbers have been
          withheld. Measure the wearer using the guidance below and consult the
          pattern’s sizing and intended ease.
        </p>
        <div class="chart-controls">
          <div class="tab-scroller">
            <div class="tabs" role="tablist" aria-label="Size category">
              {
                panels.map((p) => (
                  <button
                    type="button"
                    role="tab"
                    class={`tab-btn${p.id === defaultPanel ? " is-active" : ""}`}
                    data-tab={p.id}
                    aria-selected={p.id === defaultPanel ? "true" : "false"}
                    aria-controls={`panel-${p.id}`}
                    id={`tab-${p.id}`}
                    tabindex={p.id === defaultPanel ? 0 : -1}
                  >
                    {p.label}
                  </button>
                ))
              }
            </div>
          </div>

          <div
            class="unit-toggle"
            role="radiogroup"
            aria-label="Measurement unit"
          >
            <button
              type="button"
              role="radio"
              class="unit-btn is-active"
              data-unit="cm"
              tabindex="0"
              aria-checked="true">CM</button
            >
            <button
              type="button"
              role="radio"
              class="unit-btn"
              data-unit="inch"
              tabindex="-1"
              aria-checked="false">Inches</button
            >
          </div>
        </div>

        <div class="chart-wrap show-cm" id="chart-wrap">
          {
            panels.map((p) => (
              <div
                class={`panel${p.id === defaultPanel ? " is-active" : ""}`}
                data-panel={p.id}
                role="tabpanel"
                tabindex="0"
                id={`panel-${p.id}`}
                aria-labelledby={`tab-${p.id}`}
                hidden={p.id !== defaultPanel}
              >
                {p.intro && <p class="panel-intro">{p.intro}</p>}
                {p.tables.map((t) => (
                  <div class="table-block">
                    {t.caption && <h3 class="table-caption">{t.caption}</h3>}
                    <div class="table-scroll">
                      <table class="size-table">
                        <thead>
                          <tr>
                            <th scope="col" class="sticky-col">
                              {t.sizeHeader ?? "Measurement"}
                            </th>
                            {t.sizes.map((s) => (
                              <th scope="col">{s}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {t.rows.map((r) => (
                            <tr>
                              <th scope="row" class="sticky-col row-label">
                                {r.label}
                              </th>
                              {r.cells.map((cell) => (
                                <td
                                  data-unavailable={
                                    cell.cm === null || undefined
                                  }
                                  aria-describedby={
                                    cell.cm === null
                                      ? "size-source-note"
                                      : undefined
                                  }
                                >
                                  <span class="unit-cm">
                                    {cell.cm ?? unavailableValue}
                                  </span>
                                  <span class="unit-inch">
                                    {cell.inch ?? unavailableValue}
                                  </span>
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SEO content -->
  <section class="seo-content">
    <div class="content-inner">
      <h2 data-reveal="clip">How to take body measurements</h2>
      <p data-reveal>
        The measurements in these charts correspond to specific points on the
        body. Getting an accurate reading requires measuring in the right place.
      </p>
      <p data-reveal>
        <strong>Chest / Bust:</strong> Measure around the fullest part of the chest,
        keeping the tape level and snug but not tight. For women, this is at the fullest
        point of the bust. This is the primary measurement used to determine garment
        size.
      </p>
      <p data-reveal>
        <strong>Waist:</strong> Measure at the natural waistline, the narrowest point
        of the torso, usually just above the navel. Bending to one side helps locate
        it if you're unsure.
      </p>
      <p data-reveal>
        <strong>Hips:</strong> Measure around the widest part of the lower hip. For
        many bodies this sits below the natural waist, but the widest point matters
        more than a fixed distance. Keep the tape level.
      </p>
      <p data-reveal>
        <strong>Cross Back (shoulder to shoulder):</strong> Measure straight across
        the back from the tip of one shoulder to the other. This determines the shoulder
        width of a garment.
      </p>
      <p data-reveal>
        <strong>Back Waist Length:</strong> Measure from the prominent bone at the
        back of the neck straight down to the natural waist. This determines how long
        the torso section of a garment needs to be.
      </p>
      <p>
        <strong>Back Hip Length (men):</strong> The men’s table uses the CYC PDF’s
        neck-to-hip back length, not neck-to-waist length. Check this endpoint against
        the pattern schematic.
      </p>
      <p data-reveal>
        <strong>Arm Length: Armpit to Wrist:</strong> With the arm slightly bent,
        measure from the armpit to the wrist. This body measurement is a guide for
        sleeve length, not a finished sleeve dimension.
      </p>
      <p data-reveal>
        <strong>Upper Arm:</strong> Measure the circumference at the fullest part
        of the upper arm, with the arm relaxed at the side.
      </p>
      <p data-reveal>
        <strong>Armhole Depth:</strong> Measure vertically from the outer top edge
        of the shoulder to the armpit.
      </p>
      <p data-reveal>
        <strong>Center Back Neck-to-Wrist:</strong> With the arm straight, measure
        from the base of the neck at center back, across the shoulder and along the
        arm to the wrist.
      </p>
      <p>
        <strong>Accessories:</strong> Measure head circumference around the forehead
        and the whole head; foot length on the floor from the back of the heel to
        the longest toe; hand circumference around the dominant palm just below the
        knuckles, excluding the thumb. These are body measurements, not hat, sock
        or mitten dimensions. Foot length is not a shoe-size conversion or a complete
        sock measurement. Age ranges are only references.
      </p>

      <h2 data-reveal="clip">
        Body measurements vs finished garment measurements
      </h2>
      <p data-reveal>
        These charts show body measurements. A finished garment may be smaller,
        equal or larger, depending on the pattern’s intended ease.
      </p>
      <p data-reveal>
        <strong>Negative ease:</strong> The garment is smaller than the body. For
        a very close sweater fit, CYC's guidance is roughly 5-10 cm less than the
        actual bust or chest measurement; hats, socks, and fitted ribbing use their
        own project-specific grip.
      </p>
      <p data-reveal>
        <strong>Zero ease:</strong> The finished garment measurement equals the corresponding
        body measurement.
      </p>
      <p data-reveal>
        <strong>Positive ease:</strong> The garment is larger than the body. CYC suggests
        about 5–10 cm at the chest for a classic sweater fit; this is a guide, not
        a rule for every design.
      </p>
      <p data-reveal>
        <strong>Loose and oversized fit:</strong> CYC suggests about 10–15 cm of chest
        ease for a loose sweater and 15 cm or more for an oversized one.
      </p>
      <p data-reveal>
        For example, a pattern for a 91.5 cm body chest with a 101.5 cm finished
        chest has 10 cm of positive ease. Compare both the body-size guidance
        and the finished schematic measurements with your intended fit.
      </p>
      <p data-reveal>
        Once you know your target size, the <a href="/tools/yarn-estimator/"
          >Yarn Estimator</a
        > can sanity-check yardage, and the <a
          href="/articles/yarn-for-sweater/">sweater yarn guide</a
        > walks through sizing calculations in more depth.
      </p>

      <h2 data-reveal="clip">Choosing between sizes</h2>
      <p data-reveal>
        Between sizes, compare the finished measurements with your body and the
        ease the pattern intends. Do not automatically size down for a fitted
        garment or up for an oversized one. Stitch pattern, fiber and the
        washed, dried swatch affect stretch and drape. Hats and socks need their
        own pattern-specific ease; no fixed allowance guarantees fit.
      </p>
      <p data-reveal>
        Also compare other measurements, especially hips for longer garments and
        upper arm for fitted sleeves. If your chest says M but your hips say L,
        check the pattern's schematic to see whether the hip difference matters
        for the garment's length and silhouette.
      </p>
      <p data-reveal>
        Whichever size you pick, the <a
          href="/articles/gauge-swatch-step-by-step/">gauge swatch</a
        > decides whether the finished piece actually matches the pattern's numbers.
        The <a href="/articles/how-to-measure-knitting-gauge/"
          >how to measure gauge</a
        > guide covers the swatching process in full.
      </p>

      <h2>Sources and measurement conventions</h2>
      <p>
        <a href="https://www.craftyarncouncil.com/standards/body-sizing"
          >Craft Yarn Council: Sources and measurement conventions</a
        >. <a href="https://www.craftyarncouncil.com/standards/baby-size-chart"
          >Baby</a
        >, <a
          href="https://www.craftyarncouncil.com/standards/child-youth-sizes"
          >Child/youth</a
        >, <a href="https://www.craftyarncouncil.com/standards/woman-size"
          >Women</a
        >, <a href="https://www.craftyarncouncil.com/standards/man-size">Men</a
        >, <a
          href="https://www.craftyarncouncil.com/standards/head-circumference-chart"
          >Head</a
        >, <a href="https://www.craftyarncouncil.com/standards/foot-size-charts"
          >Foot</a
        >, <a href="https://www.craftyarncouncil.com/standards/hand-size-charts"
          >Hand</a
        >. <a
          href="https://media.craftyarncouncil.com/sites/default/files/images/standards/CYC_YarnStandards-2018-11-06.pdf"
          >CYC PDF</a
        >.
      </p>
      <p>
        Source: Craft Yarn Council. The linked PDF (pages 17–18) resolves two
        web-table errors: women’s 5XL upper arm is 19.5 inches, and the men’s
        back length ends at the hip, not the waist. The six other source
        conflicts remain unresolved. This website withholds both unit values for
        those measurements; it does not supply corrected or calculated
        replacements.
      </p>
    </div>
  </section>

  <!-- 3. FAQ -->
  <section class="tool-faq">
    <div class="faq-inner">
      <h2 data-reveal="clip">Frequently asked questions</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details data-reveal data-animate-details>
              <summary>
                {f.q}{" "}
                <span class="faq-icon" aria-hidden="true">
                  +
                </span>
              </summary>
              <p data-animate-body>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Waitlist CTA -->
  <section class="waitlist-cta" id="join">
    <div class="waitlist-inner">
      <form
        class="waitlist-form"
        action="#"
        method="post"
        id="waitlist-form"
        data-waitlist-signup
        data-localized-errors="true"
        data-source="knittools"
        data-sending-text="Sending..."
        data-generic-error="Something went wrong. Please try again."
        data-network-error="Network error. Please check your connection."
      >
        <label class="visually-hidden" for="waitlist-website" aria-hidden="true"
          >Leave this field empty</label
        >
        <input
          class="visually-hidden"
          id="waitlist-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <label class="visually-hidden" for="waitlist-email">Email address</label
        >
        <div class="waitlist-content-layer" id="waitlist-content-layer">
          <h2 class="waitlist-head">
            Where every stitch<br /><em>counts.</em>
          </h2>
          <div class="waitlist-row" id="waitlist-row" data-content>
            <input
              id="waitlist-email"
              type="email"
              name="email"
              placeholder="your@email.com"
              aria-describedby="waitlist-success waitlist-error"
              required
              class="waitlist-input"
            />
            <button type="submit" class="waitlist-btn" id="waitlist-btn"
              >Notify me at launch</button
            >
          </div>
          <p
            class="waitlist-success"
            id="waitlist-success"
            data-success
            role="status"
            aria-live="polite"
            aria-atomic="true"
            aria-hidden="true"
            hidden
          >
            You're in! We'll notify you at launch.
          </p>
          <p class="waitlist-meta">
            Coming {PRICING.launchMonthLabel} to Google Play. Launch price <strong
              ><RegionalPrice phase="launch" /></strong
            >. Regular price <strong><RegionalPrice phase="permanent" /></strong
            > later. <RegionalPricingNote />
          </p>
          <p
            class="waitlist-error"
            id="waitlist-error"
            data-error
            role="alert"
            aria-live="polite"
            aria-hidden="true"
            hidden
          >
          </p>
        </div>
      </form>
    </div>
  </section>
  <SizeChartControls />
</PageLayout>

<style>
  /* ---- Shared section rhythm (v11 editorial) ---- */
  .tool-hero,
  .seo-content,
  .tool-faq,
  .waitlist-cta {
    background: var(--paper);
    color: var(--ink);
    padding: 80px 40px;
  }

  .tool-hero {
    padding-top: 60px;
    border-bottom: 1px solid var(--ink);
  }

  .seo-content {
    border-bottom: 1px solid var(--ink);
  }

  .waitlist-cta {
    padding-bottom: 100px;
  }

  .hero-inner,
  .content-inner,
  .faq-inner,
  .waitlist-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-inner {
    max-width: 960px;
  }

  .content-inner,
  .faq-inner {
    max-width: 720px;
  }

  .waitlist-inner {
    max-width: 640px;
  }

  /* ---- 1. Tool hero ---- */
  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 24px;
  }
  .eyebrow-back {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .eyebrow-back:hover {
    color: var(--terracotta);
  }

  .tool-hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-transform: none;
    margin: 0 0 20px;
    padding-bottom: 0.08em;
  }

  .hero-intro {
    font-family: var(--body-ed);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink);
    max-width: 640px;
    margin: 0 0 12px;
  }

  .hero-note {
    font-family: var(--body-ed);
    font-style: italic;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 640px;
    margin: 0 0 40px;
  }

  /* ---- Chart controls (category tabs + unit toggle) ---- */
  .chart-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(244, 234, 217, 0.15);
  }

  .tab-scroller {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tab-scroller::-webkit-scrollbar {
    display: none;
  }

  .tabs {
    display: flex;
    gap: 24px;
    width: max-content;
  }

  .tab-btn,
  .unit-btn {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 10px 2px;
    background: transparent;
    color: var(--ink-soft);
    border: 0;
    border-bottom: 1.5px solid transparent;
    border-radius: 0;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
    white-space: nowrap;
  }

  .tab-btn:hover,
  .unit-btn:hover {
    color: var(--ink);
  }

  .tab-btn.is-active,
  .unit-btn.is-active {
    color: var(--terracotta);
    border-bottom-color: var(--terracotta);
  }

  .tab-btn:focus-visible,
  .unit-btn:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 3px;
  }

  .unit-toggle {
    display: inline-flex;
    gap: 20px;
    flex-shrink: 0;
  }

  /* ---- Panels & tables ---- */
  .panel {
    display: none;
  }
  .panel.is-active {
    display: block;
  }

  .panel-intro {
    font-family: var(--body-ed);
    font-style: italic;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 24px;
  }

  .table-block + .table-block {
    margin-top: 40px;
  }

  .table-caption {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 14px;
    font-weight: 400;
  }

  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .size-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
    background: transparent;
  }

  .size-table thead th {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
    padding: 16px 12px;
    text-align: left;
    border-bottom: 1.5px solid var(--ink);
    white-space: nowrap;
    background: transparent;
  }

  .size-table tbody td,
  .size-table tbody th {
    font-family: var(--body-ed);
    font-weight: 400;
    font-size: 16px;
    color: var(--ink);
    padding: 14px 12px;
    border-bottom: 1px solid rgba(244, 234, 217, 0.15);
    white-space: nowrap;
    text-align: left;
    background: transparent;
  }

  .size-table tbody tr:hover td,
  .size-table tbody tr:hover th.row-label {
    background-color: rgba(160, 80, 56, 0.08);
  }

  .sticky-col {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--paper);
  }

  .size-table tbody tr:hover .sticky-col {
    background: color-mix(in srgb, var(--paper) 92%, var(--terracotta) 8%);
  }

  .row-label {
    font-family: var(--body-ed);
    font-weight: 500;
    font-size: 15px;
    color: var(--ink);
    letter-spacing: 0;
    text-transform: none;
  }

  /* Unit visibility */
  .chart-wrap.show-cm .unit-inch {
    display: none;
  }
  .chart-wrap.show-inch .unit-cm {
    display: none;
  }

  /* ---- 2. SEO content ---- */
  .seo-content h2 {
    font-family: var(--serif);
    font-weight: 400;
    color: var(--ink);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.2;
    padding-bottom: 0.08em;
    letter-spacing: -0.02em;
    margin-top: 56px;
    margin-bottom: 16px;
    text-transform: none;
  }
  .seo-content h2:first-child {
    margin-top: 0;
  }

  .seo-content p {
    font-family: var(--body-ed);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 0;
  }
  .seo-content p + p {
    margin-top: 14px;
  }
  .seo-content p strong {
    font-weight: 600;
    color: var(--terracotta);
  }
  .seo-content a {
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }
  .seo-content a:hover {
    color: var(--ink);
  }

  /* ---- 3. FAQ ---- */
  .tool-faq h2 {
    font-family: var(--serif);
    font-weight: 400;
    color: var(--ink);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.2;
    padding-bottom: 0.08em;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    text-transform: none;
  }

  .faq {
    display: flex;
    flex-direction: column;
  }

  .faq details {
    border-top: 1px solid rgba(42, 30, 23, 0.2);
  }
  .faq details:last-child {
    border-bottom: 1px solid rgba(42, 30, 23, 0.2);
  }

  .faq summary {
    padding: 18px 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--body-ed);
    font-weight: 500;
    font-size: 17px;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 200ms ease;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: var(--terracotta);
  }

  .faq summary .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 1rem;
