---
import PageLayout from "../../layouts/PageLayout.astro";
import YarnEstimator from "../../components/YarnEstimator.astro";
import ToolStructuredData from "../../components/ToolStructuredData.astro";
import LaunchPriceCopy from "../../components/LaunchPriceCopy.astro";
import RegionalPricingNote from "../../components/RegionalPricingNote.astro";
import { routes } from "../../i18n/routes";

import { yarnReferenceCopy } from "../../i18n/yarnReference";
const referenceCopy = yarnReferenceCopy.en;

const canonicalPath = "/tools/yarn-estimator/";
const pageTitle = "Yarn Estimator: How Much Yarn Do I Need?";
const pageDescription = referenceCopy.description;
const faqItems = [
  { q: referenceCopy.methodTitle, a: referenceCopy.method },
  { q: referenceCopy.adviceTitle, a: referenceCopy.advice },
];
---

<PageLayout
  contentPage
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  alternates={routes.tool.yarnEstimator}
  enableRevealAnimations
>
  <ToolStructuredData
    name="Yarn Estimator"
    description={pageDescription}
    canonicalPath={canonicalPath}
    faqs={faqItems}
  />

  <!-- 1. Tool hero -->
  <section class="tool-hero">
    <div class="hero-inner">
      <p class="eyebrow">
        <a href="/tools/" class="eyebrow-back">← All tools</a>
      </p>
      <h1 data-reveal="heading" aria-label="Yarn Estimator">Yarn Estimator</h1>
      <p class="hero-intro" data-reveal>{referenceCopy.intro}</p>
      <div class="form-card variant-rust" data-reveal="scale">
        <YarnEstimator />
      </div>
    </div>
  </section>

  <!-- 2. SEO content -->
  <section class="seo-content">
    <div class="content-inner">
      <h2 data-reveal="clip">{referenceCopy.methodTitle}</h2><p data-reveal>
        {referenceCopy.method}
      </p><p data-reveal>{referenceCopy.limitations}</p>
    </div>
  </section>

  <!-- 3. FAQ -->
  <section class="tool-faq">
    <div class="faq-inner">
      <h2 data-reveal="clip">Frequently asked questions</h2>
      <div class="faq">
        {
          faqItems.map((faq) => (
            <details data-reveal data-animate-details>
              <summary>
                {faq.q}{" "}
                <span class="faq-icon" aria-hidden="true">
                  +
                </span>
              </summary>
              <p data-animate-body>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <p class="tool-release-note">
    <strong>KnitTools for Android.</strong>
    <LaunchPriceCopy />
    <RegionalPricingNote />
  </p>
</PageLayout>

<style>
  /* ---- Shared section rhythm (v11 editorial) ---- */
  .tool-hero,
  .seo-content,
  .tool-faq {
    background: var(--paper);
    color: var(--ink);
    padding: 80px 40px;
  }

  .tool-hero {
    padding-top: 60px;
    border-bottom: 1px solid var(--ink);
  }

  .seo-content {
    border-bottom: 1px solid var(--ink);
  }

  .hero-inner,
  .content-inner,
  .faq-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .content-inner,
  .faq-inner {
    max-width: 720px;
  }

  /* ---- 1. Tool hero ---- */
  .eyebrow {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 24px;
  }
  .eyebrow-back {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .eyebrow-back:hover {
    color: var(--terracotta);
  }

  .tool-hero h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-transform: none;
    margin: 0 0 20px;
    padding-bottom: 0.08em;
  }

  .hero-intro {
    font-family: var(--body-ed);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink);
    max-width: 560px;
    margin: 0 0 40px;
  }

  /* ---- 2. SEO content ---- */
  .seo-content h2 {
    font-family: var(--serif);
    font-weight: 400;
    color: var(--ink);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.2;
    padding-bottom: 0.08em;
    letter-spacing: -0.02em;
    margin-top: 56px;
    margin-bottom: 16px;
    text-transform: none;
  }
  .seo-content h2:first-child {
    margin-top: 0;
  }

  .seo-content p {
    font-family: var(--body-ed);
    color: var(--ink);
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 0;
  }
  .seo-content p strong {
    font-weight: 600;
    color: var(--terracotta);
  }

  /* ---- 3. FAQ ---- */
  .tool-faq h2 {
    font-family: var(--serif);
    font-weight: 400;
    color: var(--ink);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.2;
    padding-bottom: 0.08em;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    text-transform: none;
  }

  .faq {
    display: flex;
    flex-direction: column;
  }

  .faq details {
    border-top: 1px solid rgba(42, 30, 23, 0.2);
  }
  .faq details:last-child {
    border-bottom: 1px solid rgba(42, 30, 23, 0.2);
  }

  .faq summary {
    padding: 18px 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--body-ed);
    font-weight: 500;
    font-size: 17px;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 200ms ease;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: var(--terracotta);
  }

  .faq summary .faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 1rem;
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 300;
    color: var(--terracotta);
    line-height: 1;
    transition:
      transform 300ms ease,
      color 200ms ease;
  }
  .faq summary:hover .faq-icon {
    color: var(--ink);
  }
  .faq details[open] summary .faq-icon {
    transform: rotate(45deg);
  }

  .faq details p {
    max-width: 440px;
    padding-bottom: 18px;
    font-family: var(--body-ed);
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .tool-hero,
    .seo-content,
    .tool-faq {
      padding: 60px 20px;
    }
    .tool-hero {
      padding-top: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow-back,
    .calc-wrapper :global(.calc-btn) {
      transition: none;
    }
  }
</style>
