---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import WpiIdentifier from "../../../components/WpiIdentifier.astro";
import { routes } from "../../../i18n/routes";
import { getLocalizedYarnWeightRows } from "../../../lib/toolReferenceData";

const yarnWeightCopy = [
  {
    name: "Lace",
    regional: "Cobweb / Light fingering / 2-ply",
    uses: "Spetssjalar, dukar och fint hålmönster",
  },
  {
    name: "Super Fine",
    regional: "Sock / Fingering / Baby / 4-ply",
    uses: "Sockor, babyplagg, tunna sjalar och lätta plagg",
  },
  {
    name: "Fine",
    regional: "Sport / Baby / 5-ply",
    uses: "Lätta plagg, babykläder och accessoarer",
  },
  {
    name: "Light",
    regional: "DK / Light Worsted / 8-ply",
    uses: "Tröjor, mössor, halsdukar, babyfiltar och plagg för året runt",
  },
  {
    name: "Medium",
    regional: "Worsted / Aran / Afghan / 10-ply",
    uses: "Tröjor, mössor, vantar, filtar och de flesta vardagsstickningar",
  },
  {
    name: "Bulky",
    regional: "Chunky / Craft / Rug / 12-ply",
    uses: "Tjocka tröjor, halsdukar, filtar och snabba projekt",
  },
  {
    name: "Super Bulky",
    regional: "Super Chunky / Super Bulky / Roving",
    uses: "Tunga filtar, halskragar och snabba accessoarer",
  },
  {
    name: "Jumbo",
    regional: "Jumbo / Roving",
    uses: "Armstickning, tydlig struktur och överdimensionerade filtar",
  },
] as const;

const rows = getLocalizedYarnWeightRows(
  yarnWeightCopy,
  "maskor / 4 tum (ca 10 cm)",
);

const faqs = [
  {
    q: "Vilka garntjocklekar är mångsidiga?",
    a: "DK och worsted är användbara utgångspunkter för tröjor, mössor, halsdukar och filtar. Välj garn efter mönstrets stickfasthet och det resultat du vill ha.",
  },
  {
    q: "Kan man byta en garntjocklek mot en annan?",
    a: "Ja, men fall, garnåtgång och stickstorlek kan ändras. Gör ett stickprov i mönstrets struktur, tvätta och torka det som det färdiga plagget och kontrollera både stickfasthet och känsla. Jämför garnlängder i stället för antal nystan; det ursprungliga maskantalet räcker inte för att bestämma den nya garnåtgången.",
  },
  {
    q: 'Vad betyder "held double"?',
    a: "Det betyder att du stickar två trådar tillsammans som om de vore ett tjockare garn. Två trådar fingering motsvarar ungefär en stickad yta i ungefär DK-tjocklek, men fiber, tvinning och luftighet kan göra resultatet både lättare och tyngre. Det är användbart när du inte hittar rätt tjocklek i färgen eller fibern du vill ha. Gör ett stickprov, för resultatet går inte att förutsäga helt.",
  },
  {
    q: "Varför ser mitt garn tunnare eller tjockare ut än banderollen säger?",
    a: "Garntjocklekar är intervall. Fiber, tvinning och konstruktion påverkar utseendet, och tvätt kan ändra stickningen. Kontrollera ett tvättat och torkat stickprov i stället för att avgöra kategorin enbart utifrån utseendet.",
  },
];
---

<LocalizedToolPage
  title="Garntjocklekar: tabell med WPI"
  description="Komplett tabell över garntjocklekar från lace till jumbo. Se stickfasthet, rekommenderade stickor, WPI och vanliga projekt för varje kategori."
  canonicalPath={routes.tool.yarnWeightChart.sv}
  lang="sv"
  alternates={routes.tool.yarnWeightChart}
  intro="CYC-kategorier med intervall för stickfasthet, stickstorlek och WPI. Öppna en kategori för detaljer."
  schemaName="Garntjocklekstabell"
  schemaDescription="Referenstabell över garntjocklekar med stickfasthet, rekommenderade stickor, WPI och projekttyper för de publicerade CYC-kategorierna."
  faqs={faqs}
  variant="sand"
>
  <div slot="tool">
    <p>
      <a href="https://www.craftyarncouncil.com/standards/yarn-weight-system"
        >CYC:s riktvärden</a
      > gäller maskantal i slätstickning över 4 tum (ungefär 10 cm) och stickstorlekar
      att börja med. Spets stickas ofta på grövre stickor för ett öppet resultat;
      följ mönstrets stickfasthet. Regionala namn är ungefärliga jämförelser, inte
      exakta motsvarigheter.
    </p>
    <div class="cat-list">
      {
        rows.map((row) => (
          <details class="cat-card">
            <summary class="cat-summary">
              <span class="cat-heading">
                <span>{row[0]}</span>
                <span class="cat-name">{row[1]}</span>
              </span>
              <span class="cat-regional">{row[2]}</span>
              <span class="cat-toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="cat-body">
              <dl class="cat-details">
                <div class="cat-row">
                  <dt>Stickfasthet</dt>
                  <dd>{row[3]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Stickor</dt>
                  <dd>{row[4]}</dd>
                </div>
                <div class="cat-row">
                  <dt>WPI</dt>
                  <dd>{row[5]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Vanlig användning</dt>
                  <dd>{row[6]}</dd>
                </div>
                <div class="cat-row">
                  <dt>Regionala namn</dt>
                  <dd>{row[7]}</dd>
                </div>
              </dl>
            </div>
          </details>
        ))
      }
    </div>
    <WpiIdentifier lang="sv" />
  </div>

  <div slot="content">
    <h2>Problemet med alla namn</h2>
    <p>Regionala garnnamn kan göra det svårt att välja ersättningsgarn.</p>

    <h3>Ply betyder inte det du tror</h3>
    <p>
      "4-ply" i brittiska och australiska mönster betyder oftast fingering. Men
      ply beskriver egentligen konstruktion, inte tjocklek. Ett garn gjort av
      fyra tunna trådar kan absolut vara tunnare än ett garn gjort av två
      tjocka. Entrådiga garner kan vara bulky. Ett hårt tvinnat 6-ply kan hamna
      i sport.
    </p>
    <p>
      I ett äldre mönster bör du kontrollera det angivna garnet och
      stickfastheten i stället för att gissa tjockleken från ply-talet.
      Regionala ply-namn är beteckningar för tjocklek, inte alltid antalet
      trådar i garnet.
    </p>
    <p>Det ställer till det för fler än man tror.</p>

    <h3>Worsted och aran: nära, men inte samma</h3>
    <p>
      Båda ligger i CYC kategori 4, Medium, men aran ligger ofta lite tyngre
      inom intervallet. Ett mönster skrivet för aran-garn vid en viss
      stickfasthet kan bli för löst om du tar ett worsted-garn som ligger i den
      tunnare delen av kategorin. Det omvända gäller också.
    </p>
    <p>
      Vissa garnföretag använder "worsted" och "aran" omväxlande på banderoller.
      Andra drar en tydlig gräns. Stickfastheten på banderollen är mer pålitlig
      än namnet.
    </p>

    <h3>DK, Light Worsted, 8-ply</h3>
    <p>
      DK, double knitting, är standardterminologi i Storbritannien. Amerikanska
      mönster kan kalla samma tjocklek "Light Worsted". Australiska och
      nyzeeländska mönster säger ofta "8-ply". Alla tre hamnar i CYC kategori 3,
      Light, men ett garn i den grövre änden av DK kan överlappa den tunnare
      änden av worsted. Kategorigränser är inga väggar.
    </p>

    <h3>När regionala namn krockar</h3>
    <p>
      "Sport weight" i Nordamerika och "5-ply" i australisk terminologi
      överlappar, men de matchar inte perfekt. "Chunky" i brittiska mönster
      betyder oftast CYC kategori 5, Bulky, medan "chunky" i vardaglig
      amerikansk användning kan betyda allt från bulky till super bulky.
    </p>
    <p>
      Det säkraste när du rör dig mellan regionala mönsterspråk: strunta helt i
      namnet och matcha stickfastheten. Om mönstret säger 20 maskor per 10 cm på
      4 mm stickor är det det du behöver träffa, oavsett vad banderollen kallar
      garnet.
    </p>

    <h2>Så fungerar garntjocklekskategorier</h2>
    <p>
      "Weight" betyder här inte hur tungt nystanet känns i handen. Det syftar på
      trådens tjocklek. Tunnare garn ger fler maskor per 10 cm. Tjockare garn,
      färre.
    </p>
    <p>
      Craft Yarn Councils system ger varje tjockleksintervall ett nummer och ett
      namn:
    </p>
    <ul>
      <li>
        <strong>0 - Lace.</strong> Mycket tunt garn för spetssjalar och öppna mönster.
      </li>
      <li><strong>1 - Super Fine.</strong> Fingering och sockgarn.</li>
      <li><strong>2 - Fine.</strong> Sport.</li>
      <li>
        <strong>3 - Light.</strong> DK och liknande mellantjocka plagg-garner.
      </li>
      <li>
        <strong>4 - Medium.</strong> Worsted och aran.
      </li>
      <li>
        <strong>5 - Bulky.</strong> Tjockare garner som ger stora maskor och snabba
        projekt.
      </li>
      <li>
        <strong>6 - Super Bulky.</strong> Snabba accessoarer, tydlig struktur.
      </li>
      <li>
        <strong>7 - Jumbo.</strong> Den tjockaste delen av den publicerade tabellen.
      </li>
    </ul>
    <p>
      Sidan omfattar kategorierna 0–7 i de länkade CYC-tabellerna, från det
      tunna Lace till det mycket tjocka Jumbo. Sock och Baby beskriver vanliga
      användningar, inte en enda garntjocklek. Gram anger nystanets vikt och
      meter garnets längd; inget av dem avgör ensamt garntjockleken.
    </p>

    <h2>Så identifierar du garntjocklek utan banderoll</h2>
    <p>
      Garn utan banderoll dyker upp hela tiden. Någon ger bort en påse restgarn,
      banderollen försvann för månader sedan, eller garnet kom från en kon utan
      butiksetikett.
    </p>
    <p>
      Det snabbaste första testet är WPI, alltså hur många lindningar som ryms
      på 2,54 cm.
    </p>

    <h3>Mäta WPI</h3>
    <p>
      Linda garnet runt en penna, linjal eller WPI-mätare. Håll varven lagom
      täta och sida vid sida, inte utsträckta eller överlappande. Räkna hur
      många som ryms på 2,54 cm. CYC-guiden använder de här breda intervallen:
    </p>
    <p>
      <a
        href="https://www.craftyarncouncil.com/standards/how-measure-wraps-inch-wpi"
        >CYC:s WPI-guide</a
      >
    </p>
    <ul>
      <li>30-40+ WPI -&gt; Lace (0)</li>
      <li>14-30 WPI -&gt; Super Fine (1)</li>
      <li>12-18 WPI -&gt; Fine (2)</li>
      <li>11-15 WPI -&gt; Light (3)</li>
      <li>9-12 WPI -&gt; Medium (4)</li>
      <li>6-9 WPI -&gt; Bulky (5)</li>
      <li>5-6 WPI -&gt; Super Bulky (6)</li>
      <li>1-4 WPI -&gt; Jumbo (7)</li>
    </ul>
    <p>
      Lägg märke till de överlappande intervallen. Ett garn som mäter 12 WPI kan
      vara Fine, Light eller Medium beroende på andra faktorer. Det är normalt.
    </p>

    <h3>När WPI blir knepigt</h3>
    <p>
      Luddiga garner som mohair är besvärliga att linda rent. Luftiga entrådiga
      garner kan se tunnare ut än de faktiskt stickas upp. Handspunnet skiftar
      tjocklek längs tråden, så mät på flera ställen och ta ett snitt. Chenille
      och strukturerade effektgarner? Lycka till att få en ren lindning alls.
    </p>
    <p>
      WPI tar dig till rätt område. Ett stickprov ger svaret som faktiskt spelar
      roll. <a href="/sv/artiklar/identifiera-okant-garn-utan-banderoll/"
        >Guiden till okänt garn</a
      > går igenom hela identifieringen när banderollen saknas helt.
    </p>

    <h2>Välja garntjocklek till projektet</h2>
    <p>
      Mönsterdesigners väljer tjocklek för den stickade yta de vill ha, inte
      bara för hastigheten. Byter du tjocklek ändras fall, täthet, värme och
      ofta hela skalan på det färdiga arbetet.
    </p>
    <p>
      Tunna garner (0–2) används ofta till sockor, sjalar och detaljerad
      flerfärgsstickning. DK och worsted (3–4) passar många plagg, mössor och
      filtar; tjocka garner (5–7) kan ge större maskor och snabbare projekt.
      Fall, värme, maskdefinition och färdig vikt beror också på fiber,
      konstruktion, strukturmönster och stickfasthet, inte bara tjocklek.
    </p>
    <p>
      Om du byter utanför den ursprungliga tjocklekskategorin behöver du räkna
      om. <a href="/sv/artiklar/byta-garn-i-stickmonster/"
        >Guiden till garnbyte</a
      > går igenom processen. KnitTools <a
        href={routes.tool.castOnCalculator.sv}>uppläggningskalkylator</a
      > hjälper med maskantal, och <a href={routes.tool.yarnEstimator.sv}
        >garnåtgångskalkylatorn</a
      > kan rimlighetskontrollera garnåtgången innan du köper.
    </p>

    <h2>Sambandet mellan garntjocklek och stickstorlek</h2>
    <p>
      Rekommenderade stickstorlekar är startpunkter. Inte löften. Samma DK-garn
      kan ge en fast mössyta på en sticka och en lös koftyta på en annan.
    </p>
    <p>
      Det är här stickfastheten tar över. Banderollen kan peka dig åt ett håll,
      men ditt garn, ditt handlag och ditt projekt bestämmer den slutliga
      stickstorleken.
    </p>
    <p>
      Om du behöver översätta storlekssystem innan du kan göra ett stickprov är <a
        href={routes.tool.needleSizeChart.sv}>stickstorlekstabellen</a
      > en bra följesida att ha öppen.
    </p>
  </div>
</LocalizedToolPage>
