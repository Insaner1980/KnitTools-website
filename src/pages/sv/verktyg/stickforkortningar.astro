---
import LocalizedToolPage from "../../../components/LocalizedToolPage.astro";
import { routes } from "../../../i18n/routes";

type Category =
  | "cast-on-bind-off"
  | "increases"
  | "decreases"
  | "cables"
  | "lace"
  | "general"
  | "stitch-patterns";

interface Abbreviation {
  abbr: string;
  def: string;
  search: string;
  categories: Category[];
}

const categoryLabels: Record<Category, string> = {
  "cast-on-bind-off": "Uppläggning / avmaskning",
  increases: "Ökningar",
  decreases: "Minskningar",
  cables: "Flätor",
  lace: "Spets",
  general: "Allmänt",
  "stitch-patterns": "Maskmönster",
};

const abbreviations: Abbreviation[] = [
  {
    abbr: "CO",
