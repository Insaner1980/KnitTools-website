---

<div class="wpi-tool gs-form" data-wpi-tool>
  <h2 class="wpi-heading">{copy.heading}</h2>
  <p class="wpi-intro">{copy.intro}</p>
  <p class="wpi-intro">{copy.note}</p>
  <div class="wpi-input-wrap">
    <input
      type="text"
      class="wpi-input"
      aria-label={copy.prompt}
      placeholder={copy.placeholder}
      inputmode="decimal"
      autocomplete="off"
      data-wpi-input
    />
  </div>
  <p class="wpi-result" aria-live="polite" data-wpi-result>{copy.prompt}</p>
  <noscript>
    <p class="wpi-fallback">{copy.fallback}</p>
  </noscript>
</div>

<script
  is:inline
  define:vars={{
    wpiCategories: categories,
    wpiCopy: copy,
    wpiLocale: lang === "no" ? "nb" : lang,
  }}
>
  (() => {
    const tool = document.currentScript?.previousElementSibling;
    if (!tool || !tool.matches("[data-wpi-tool]")) return;

    const input = tool.querySelector("[data-wpi-input]");
    const result = tool.querySelector("[data-wpi-result]");
    if (!input || !result) return;

    const joinParts = (parts) => {
      if (parts.length === 1) return parts[0];
      if (parts.length === 2) return `${parts[0]} ${wpiCopy.or} ${parts[1]}`;
      return `${parts.slice(0, -1).join(", ")} ${wpiCopy.or} ${parts[parts.length - 1]}`;
    };

    const formatMatches = (matches) => {
      if (matches.length === 1) {
        const match = matches[0];
        return `${wpiCopy.suggests} ${match.name} (CYC ${match.cyc}), ${match.regional}. ${wpiCopy.swatch}`;
      }

      const parts = matches.map((match) => `${match.name} (CYC ${match.cyc})`);
      return `${wpiCopy.matches} ${joinParts(parts)}. ${wpiCopy.swatch}`;
    };

    input.addEventListener("input", () => {
      const raw = input.value.trim();
      if (raw === "") {
        input.removeAttribute("aria-invalid");
        result.textContent = wpiCopy.prompt;
        return;
      }

      // Native number fields can discard a comma instead of treating it as a decimal.
      const isNumber = /^[+-]?(?:\d+(?:[.,]\d*)?|[.,]\d+)(?:e[+-]?\d+)?$/i.test(
        raw,
      );
      const value = isNumber ? Number(raw.replace(",", ".")) : NaN;
      if (!Number.isFinite(value) || value < 1 || value > 40) {
        input.setAttribute("aria-invalid", "true");
        result.textContent = wpiCopy.invalid;
        return;
      }

      input.removeAttribute("aria-invalid");
      const displayedValue = new Intl.NumberFormat(wpiLocale, {
        maximumSignificantDigits: 15,
      }).format(value);
      const matches = wpiCategories.filter(
        (category) => value >= category.min && value <= category.max,
      );
      result.textContent =
        matches.length === 0
          ? `${displayedValue} WPI ${wpiCopy.between}`
          : `${displayedValue} WPI ${formatMatches(matches)}`;
    });
  })();
</script>

<style>
  .wpi-tool {
    margin-top: 8px;
    padding-top: 32px;
    border-top: 1px solid rgba(244, 234, 217, 0.2);
  }

  .wpi-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 10px;
    text-transform: none;
  }

  .wpi-intro {
    font-family: var(--body-ed);
    font-weight: 400;
    font-size: 16px;
    color: var(--ink);
    line-height: 1.55;
    margin: 0 0 18px;
    max-width: 560px;
  }

  .wpi-input-wrap {
    max-width: 220px;
  }

  .wpi-input {
    width: 100%;
    height: 52px;
    padding: 0 18px;
    font-size: 16px;
    font-family: var(--body-ed);
    background-color: var(--paper-2);
    border: 1.5px solid var(--ink);
    color: var(--ink);
    outline: none;
    border-radius: 0;
    box-sizing: border-box;
    transition:
      border-color 300ms ease,
      box-shadow 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .wpi-input::placeholder {
    color: var(--ink-soft);
  }

  .wpi-input:focus {
    border-color: var(--terracotta);
    outline: 2px solid var(--terracotta);
    outline-offset: 2px;
  }

  .wpi-input::-webkit-outer-spin-button,
  .wpi-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .wpi-input[type="text"] {
    -moz-appearance: textfield;
  }

  .wpi-result {
    font-family: var(--body-ed);
    font-style: italic;
    font-weight: 400;
    font-size: 16px;
    color: var(--ink);
    margin: 16px 0 0;
    line-height: 1.5;
    min-height: 1.5em;
  }

  .wpi-fallback {
    font-family: var(--body-ed);
    font-size: 14px;
    color: var(--terracotta);
    margin: 12px 0 0;
  }
</style>
