const referenceCopy = yarnReferenceCopy[lang];
const number = new Intl.NumberFormat(lang === "no" ? "nb" : lang, {
  maximumFractionDigits: 3,
});
const references = yarnReferences.map((item) => {
  const dimensionLabel = item.dimensionLabel
    ? referenceCopy[item.dimensionLabel]
    : item.family === "cowl"
      ? referenceCopy.cowlDimensions
      : referenceCopy.flatDimensions;
  const dimensions =
    (item.gauge[2] === 10 ? "" : "≈ ") +
    item.dimensionsCm.map((value) => number.format(value)).join(" × ") +
    " cm";
  return {
    ...item,
    label: item.name + " / " + item.size + " / " + dimensions,
    sizeLabel: item.size + " / " + dimensions,
    details: [
      referenceCopy[item.basis],
      referenceCopy.dimensions + ": " + dimensionLabel + " " + dimensions,
      referenceCopy.gauge +
        ": " +
        item.gauge[0] +
        " " +
        referenceCopy.stitches +
        (item.gauge[1] === null
          ? ""
          : " × " +
            item.gauge[1] +
            " " +
            (item.family === "cowl" || item.rounds
              ? referenceCopy.rounds
              : referenceCopy.rows)) +
        " / " +
        number.format(item.gauge[2]) +
        (item.gauge[1] === null ? "" : " × " + number.format(item.gauge[2])) +
        " cm",
      referenceCopy.construction + ": " + referenceCopy[item.family],
      referenceCopy.yarn + ": " + item.yarn,
      referenceCopy.materials + ": " + item.materials,
      ...(item.bodyCm
        ? [
            referenceCopy.bodyBust +
              ": " +
              item.bodyCm.map((value) => number.format(value)).join("–") +
              " cm",
          ]
        : []),
      ...(item.fit ? [referenceCopy[item.fit]] : []),
    ],
  };
});
---

<div
  class="yarn-estimator"
  data-error={copy.error}
  data-meters-label={copy.metersLabel}
  data-yards-label={copy.yardsLabel}
  data-lang={lang === "no" ? "nb" : lang}
  data-references={JSON.stringify(references)}
  data-unavailable={referenceCopy.unavailable}
  data-source-label={referenceCopy.source}
  data-disclaimer={referenceCopy.reference}
>
  <p class="reference-intro">{referenceCopy.reference}</p>
  <p class="reference-intro">{referenceCopy.coverage}</p>
  <fieldset>
    <legend class="sr-only">{copy.legend}</legend>

    <div class="form-group">
      <label for="project-type">{copy.projectType}</label>
      <select id="project-type">
        <optgroup label={copy.adultGarments}>
          <option value="sweater">{copy.options.sweater}</option>
          <option value="cardigan">{copy.options.cardigan}</option>
          <option value="vest">{copy.options.vest}</option>
          <option value="poncho">Poncho</option>
        </optgroup>
        <optgroup label={copy.childGarments}>
          <option value="child-sweater">{copy.options.childSweater}</option>
          <option value="child-cardigan">{copy.options.childCardigan}</option>
        </optgroup>
        <optgroup label={copy.babyGarments}>
          <option value="baby-sweater">{copy.options.babySweater}</option>
          <option value="baby-cardigan">{copy.options.babyCardigan}</option>
          <option value="baby-booties">{copy.options.babyBooties}</option>
        </optgroup>
        <optgroup label={copy.hats}>
          <option value="adult-hat">{copy.options.adultHat}</option>
          <option value="child-hat">{copy.options.childHat}</option>
          <option value="baby-hat">{copy.options.babyHat}</option>
          <option value="headband">{copy.options.headband}</option>
        </optgroup>
        <optgroup label={copy.hands}>
          <option value="adult-mittens">{copy.options.adultMittens}</option>
          <option value="child-mittens">{copy.options.childMittens}</option>
          <option value="adult-gloves">{copy.options.adultGloves}</option>
          <option value="fingerless-mitts"
            >{copy.options.fingerlessMitts}</option
          >
        </optgroup>
        <optgroup label={copy.feet}>
          <option value="adult-socks">{copy.options.adultSocks}</option>
          <option value="child-socks">{copy.options.childSocks}</option>
          <option value="slippers">{copy.options.slippers}</option>
        </optgroup>
        <optgroup label={copy.neck}>
          <option value="scarf">{copy.options.scarf}</option>
          <option value="cowl">{copy.options.cowl}</option>
          <option value="shawl">{copy.options.shawl}</option>
          <option value="wrap">{copy.options.wrap}</option>
        </optgroup>
        <optgroup label={copy.blankets}>
          <option value="baby-blanket">{copy.options.babyBlanket}</option>
          <option value="throw-blanket">{copy.options.throwBlanket}</option>
          <option value="lap-blanket">{copy.options.lapBlanket}</option>
          <option value="afghan">{copy.options.afghan}</option>
        </optgroup>
        <optgroup label={copy.home}>
          <option value="dishcloth">{copy.options.dishcloth}</option>
          <option value="pillow-cover">{copy.options.pillowCover}</option>
        </optgroup>
      </select>
      <p class="selected-label" aria-hidden="true" hidden></p>
    </div>

    <div class="form-group">
      <label for="reference-pattern">{referenceCopy.patternName}</label>
      <select id="reference-pattern">
        {
          [
            ...new Map(
              references
                .filter((item) => item.project === "sweater")
                .map((item) => [item.family, item.name]),
            ).entries(),
          ].map(([family, name]) => <option value={family}>{name}</option>)
        }
      </select>
      <p class="selected-label" aria-hidden="true" hidden></p>
    </div>

    <div class="form-group">
      <label for="project-size">{referenceCopy.case}</label>
      <select id="project-size">
        {
          references
            .filter(
              (item) => item.project === "sweater" && item.family === "novice",
            )
            .map((item) => <option value={item.id}>{item.sizeLabel}</option>)
        }
      </select>
      <p class="selected-label" aria-hidden="true" hidden></p>
    </div>

    <div class="form-group">
      <label for="length-unit">{referenceCopy.unit}</label>
      <select id="length-unit">
        <option value="m">{copy.metersLabel}</option>
        <option value="yd">{copy.yardsLabel}</option>
      </select>
      <p class="selected-label" aria-hidden="true" hidden></p>
    </div>

    <button type="button" class="btn-primary estimate-btn"
      >{referenceCopy.show}</button
    >

    <div class="result-area" aria-live="polite" aria-atomic="true">
      <div class="result-wrapper">
        <div class="result-value" id="yarn-result"></div>
      </div>
    </div>
  </fieldset>
</div>

<script>
  import { referenceQuantity } from "../lib/yarnReferences";

  function initYarnEstimator() {
    document.querySelectorAll(".yarn-estimator").forEach((est) => {
      const projectSelect = est.querySelector(
        "#project-type",
      ) as HTMLSelectElement;
      const sizeSelect = est.querySelector(
        "#project-size",
      ) as HTMLSelectElement;
      const patternSelect = est.querySelector(
        "#reference-pattern",
      ) as HTMLSelectElement;
      const unitSelect = est.querySelector("#length-unit") as HTMLSelectElement;
      const estimateBtn = est.querySelector(
        ".estimate-btn",
      ) as HTMLButtonElement;
      const resultEl = est.querySelector("#yarn-result") as HTMLElement;
      const resultArea = est.querySelector(".result-area") as HTMLElement;
      if (
        !projectSelect ||
        !sizeSelect ||
        !patternSelect ||
        !unitSelect ||
        !estimateBtn ||
        !resultEl ||
        !resultArea
      )
        return;
      const references = JSON.parse(
        est.getAttribute("data-references") || "[]",
      ) as {
        id: string;
        project: string;
        family: string;
        name: string;
        label: string;
        sizeLabel: string;
        details: string[];
        source: string;
      }[];
      const format = new Intl.NumberFormat(
        est.getAttribute("data-lang") || "en",
        { maximumFractionDigits: 0 },
      );

      const id = Math.random().toString(36).slice(2, 8);
      patternSelect.id = `reference-pattern-${id}`;
      (patternSelect.previousElementSibling as HTMLElement).setAttribute(
        "for",
        patternSelect.id,
      );
      projectSelect.id = `project-type-${id}`;
      (projectSelect.previousElementSibling as HTMLElement).setAttribute(
        "for",
        projectSelect.id,
      );
      sizeSelect.id = `project-size-${id}`;
      (sizeSelect.previousElementSibling as HTMLElement).setAttribute(
        "for",
        sizeSelect.id,
      );
      unitSelect.id = `length-unit-${id}`;
      (unitSelect.previousElementSibling as HTMLElement).setAttribute(
        "for",
        unitSelect.id,
      );
      resultEl.id = `yarn-result-${id}`;

      function updateSizes() {
        const cases = references.filter(
          (item) =>
            item.project === projectSelect.value &&
            item.family === patternSelect.value,
        );
        sizeSelect.textContent = "";
        for (const item of cases) {
          const option = document.createElement("option");
          option.value = item.id;
          option.textContent = item.sizeLabel;
          sizeSelect.appendChild(option);
        }
        if (!cases.length) {
          const option = document.createElement("option");
          option.value = "";
          option.textContent = est.getAttribute("data-unavailable") || "";
          sizeSelect.appendChild(option);
        }
      }
      function updatePatterns() {
        patternSelect.textContent = "";
        const patterns = new Map(
          references
            .filter((item) => item.project === projectSelect.value)
            .map((item) => [item.family, item.name]),
        );
        for (const [family, name] of patterns) {
          const option = document.createElement("option");
          option.value = family;
          option.textContent = name;
          patternSelect.appendChild(option);
        }
        if (!patterns.size) {
          const option = document.createElement("option");
          option.value = "";
          option.textContent = est.getAttribute("data-unavailable") || "";
          patternSelect.appendChild(option);
        }
        updateSizes();
      }
      updatePatterns();
      projectSelect.addEventListener("change", updatePatterns);
      patternSelect.addEventListener("change", updateSizes);

      const selects = [projectSelect, patternSelect, sizeSelect, unitSelect];
      const textMeasure = document.createElement("canvas").getContext("2d")!;
      function updateSelectedLabels() {
        selects.forEach((select) => {
          const label = select.nextElementSibling as HTMLElement;
          const text = select.selectedOptions[0]?.textContent || "";
          const style = getComputedStyle(select);
          textMeasure.font = style.font;
          const availableWidth =
            select.clientWidth -
            parseFloat(style.paddingLeft) -
            parseFloat(style.paddingRight);
          label.textContent = text;
          label.hidden = textMeasure.measureText(text).width <= availableWidth;
        });
      }
      updateSelectedLabels();
      // Runs after the project listener has rebuilt and reset the size options.
      selects.forEach((select) =>
        select.addEventListener("change", () => {
          updateSelectedLabels();
          resultEl.textContent = "";
          resultArea.classList.remove("is-open");
        }),
      );
      const labelResizeObserver = new ResizeObserver(updateSelectedLabels);
      selects.forEach((select) => labelResizeObserver.observe(select));
      void document.fonts.ready.then(updateSelectedLabels);

      estimateBtn.addEventListener("click", () => {
        const result = referenceQuantity(
          projectSelect.value,
          sizeSelect.value,
          unitSelect.value,
        );
        resultEl.textContent = "";
        resultEl.className = "result-value";
        resultArea.classList.add("is-open");
        if (!result || result.reference.family !== patternSelect.value) {
          const message = document.createElement("span");
          message.className = "form-error";
          message.textContent = est.getAttribute("data-unavailable") || "";
          resultEl.appendChild(message);
          return;
        }
        const details = references.find(
          (item) => item.id === result.reference.id,
        )!;
        const wrapper = document.createElement("div");
        wrapper.className = "tool-result";
        const title = document.createElement("p");
        title.textContent = details.label;
        wrapper.appendChild(title);
        const number = document.createElement("span");
        number.className =
          result.quantityMax === undefined
            ? "result-number"
            : "result-number is-range";
        number.textContent =
          format.format(result.quantity) +
          (result.quantityMax === undefined
            ? ""
            : "–" + format.format(result.quantityMax));
        wrapper.appendChild(number);
        const unit = document.createElement("span");
        unit.className = "result-label";
        unit.textContent =
          est.getAttribute(
            unitSelect.value === "m" ? "data-meters-label" : "data-yards-label",
          ) || "";
        wrapper.appendChild(unit);
        for (const text of [
          ...details.details,
          est.getAttribute("data-disclaimer") || "",
        ]) {
          const paragraph = document.createElement("p");
          paragraph.textContent = text;
          wrapper.appendChild(paragraph);
        }
        const link = document.createElement("a");
        link.href = details.source;
        link.textContent = est.getAttribute("data-source-label") || "";
        wrapper.appendChild(link);
        resultEl.appendChild(wrapper);
      });
    });
  }
  initYarnEstimator();
</script>

