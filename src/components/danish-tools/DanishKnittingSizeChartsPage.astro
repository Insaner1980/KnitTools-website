const defaultPanel = "kvinde";

const faqs = [
  {
    q: "Er målene ens i alle strikkeopskrifter?",
    a: "CYC udgiver referencetabeller, men alle strikkeopskrifter bruger ikke samme størrelsessystem. Designere kan have egne mål og størrelsesbetegnelser. Tjek altid opskriftens egen størrelsestabel og målskitse.",
  },
  {
    q: "Hvordan vælger jeg størrelse, hvis opskriften bruger numre i stedet for XS/S/M/L?",
    a: "Brug opskriftens mål, ikke kun tallet eller bogstavet. Tjek, om målene gælder kroppen eller det færdige arbejde; tag højde for det tilsigtede bevægelsesrum ved færdige mål. Til en sweater sammenligner du brystmål og andre mål, der er vigtige for pasformen.",
  },
  {
    q: "Skal jeg måle over tøj eller direkte på kroppen?",
    a: "Mål direkte på huden eller over et tyndt, tætsiddende lag, og undgå tykt tøj. Hold kropsmål og færdige tøjmål adskilt; opskriftens bevægelsesrum tager højde for den ønskede pasform.",
  },
  {
    q: "Hvad hvis mine mål ikke passer pænt i én størrelse?",
    a: "Det er normalt. De fleste kroppe har ikke samme størrelse alle steder. Prioritér det vigtigste mål for projektet: bryst til en sweater, hofter til en nederdel, hovedomkreds til en hue. Mange opskrifter forklarer, hvordan bestemte dele kan gøres længere eller kortere.",
  },
];
---

<LocalizedToolPage
  title="Størrelsestabeller til strik"
  description="Standard kropsmål til strik fra baby til voksen. Se bryst, talje, hofter, ærmelængde og andre mål i cm og tommer, når du vælger størrelse."
  canonicalPath={danishToolRoutes.knittingSizeCharts}
  lang="da"
  alternates={danishToolAlternates.tool.knittingSizeCharts}
  intro="Standard kropsmål i cm til strikkeprojekter. Skift til tommer, når du sammenligner med en US- eller UK-opskrift."
  schemaName="Størrelsestabeller til strik"
  schemaDescription="Referencetabeller med standard kropsmål til strik, fra baby til voksen."
  faqs={faqs}
  variant="terracotta"
  enableSizeChartControls
>
  <div slot="tool" data-size-chart data-mobile-size-label="Vælg størrelse">
    <p class="panel-intro">
      Det er kropsmål, ikke mål på det færdige arbejde. Læg bevægelsesrum til
      for den pasform, du vil have.
    </p>
    <p class="panel-intro">
      Dette er CYC’s vejledende kropsmål, ikke færdige tøjmål eller universelle
      størrelser. Børne- og ungdomsnumrene er amerikanske referencestørrelser,
      ikke alder eller europæiske højdestørrelser. Babyaldre er omtrentlige.
      XS–5XL følger CYC; 2XL–5XL svarer til deres 2X–5X. Mål personen, og brug
      opskriftens egen størrelsestabel.
    </p>
    <p class="panel-intro" id="size-source-note">
      CM og tommer viser CYC’s publicerede, afrundede par, ikke præcise
      omregninger. Seks mål mangler bekræftede kildeværdier, fordi de
      publicerede værdier er modstridende. Begge værdier er udeladt. Mål kroppen
      efter vejledningen nedenfor, og se opskriftens størrelsesguide og
      tilsigtede bevægelsesrum.
    </p>
    <div class="chart-controls">
      <div class="tab-scroller">
        <div class="tabs" role="tablist" aria-label="Størrelseskategori">
          {
            panels.map((panel) => (
              <button
                type="button"
                role="tab"
                class={`tab-btn${panel.id === defaultPanel ? " is-active" : ""}`}
                data-tab={panel.id}
                aria-selected={panel.id === defaultPanel ? "true" : "false"}
                aria-controls={`panel-${panel.id}`}
                id={`tab-${panel.id}`}
                tabindex={panel.id === defaultPanel ? 0 : -1}
              >
                {panel.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="unit-toggle" role="radiogroup" aria-label="Måleenhed">
        <button
          type="button"
          role="radio"
          class="unit-btn is-active"
          data-unit="cm"
          tabindex="0"
          aria-checked="true">CM</button
        >
        <button
          type="button"
          role="radio"
          class="unit-btn"
          data-unit="inch"
          tabindex="-1"
          aria-checked="false">Tommer</button
        >
      </div>
    </div>

    <div class="chart-wrap show-cm" id="da-size-chart-wrap">
      {
        panels.map((panel) => (
          <div
            class={`panel${panel.id === defaultPanel ? " is-active" : ""}`}
            data-panel={panel.id}
            role="tabpanel"
            tabindex="0"
            id={`panel-${panel.id}`}
            aria-labelledby={`tab-${panel.id}`}
            hidden={panel.id !== defaultPanel}
          >
            {panel.intro && <p class="panel-intro">{panel.intro}</p>}
            {panel.tables.map((table) => (
              <div class="table-block">
                {table.caption && (
                  <h3 class="table-caption">{table.caption}</h3>
                )}
                <div class="table-scroll">
                  <table class="size-table">
                    <thead>
                      <tr>
                        <th scope="col" class="sticky-col">
                          {table.sizeHeader ?? "Størrelse"}
                        </th>
                        {table.sizes.map((size) => (
                          <th scope="col">{size}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {table.rows.map((row) => (
                        <tr>
                          <th scope="row" class="sticky-col row-label">
                            {row.label}
                          </th>
                          {row.cells.map((cell) => (
                            <td
                              data-unavailable={cell.cm === null || undefined}
                              aria-describedby={
                                cell.cm === null
                                  ? "size-source-note"
                                  : undefined
                              }
                            >
                              <span class="unit-cm">
                                {formatNumberText(cell.cm ?? unavailableValue)}
                              </span>
                              <span class="unit-inch">
                                {formatNumberText(
                                  cell.inch ?? unavailableValue,
                                )}
                              </span>
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div slot="content">
    <h2>Sådan tager du kropsmål</h2>
    <p>
      Målene i tabellerne hører til bestemte steder på kroppen. Hvis tallet skal
      bruges til en strikkeopskrift, skal du måle samme sted hver gang.
    </p>
    <p>
      <strong>Brystmål:</strong> Mål rundt om det bredeste sted på brystet, med målebåndet
      vandret, tæt på kroppen men uden at stramme. Hos kvinder er det over det fyldigste
      sted på brystet. Det er det vigtigste mål til overdele.
    </p>
    <p>
      <strong>Talje:</strong> Mål rundt om den naturlige talje, det smalleste sted
      på kroppen, ofte lige over navlen. Er du i tvivl, så bøj dig til siden; folden
      viser, hvor taljen sidder.
    </p>
    <p>
      <strong>Hofter:</strong> Mål rundt om det bredeste sted på hofterne med målebåndet
      vandret. Brug kroppens bredeste punkt, ikke en fast afstand under taljen.
    </p>
    <p>
      <strong>Rygbredde:</strong> Mål lige hen over ryggen, fra skulderpunkt til skulderpunkt.
      Det bestemmer skulderbredden i det færdige arbejde.
    </p>
    <p>
      <strong>Ryglængde til talje:</strong> Mål fra knoglen nederst i nakken til den
      naturlige talje. Det viser, hvor lang kroppen i modellen skal være.
    </p>
    <p>
      <strong>Ryglængde til hofte (mand):</strong> Herretabellen følger CYC’s PDF
      og måles fra nakken til hoften, ikke taljen. Kontrollér målepunktet i opskriftens
      målskitse.
    </p>
    <p>
      <strong>Armlængde: armhule til håndled:</strong> Mål fra armhulen til håndleddet
      med armen let bøjet. Kropsmålet er et udgangspunkt for ærmelængden, ikke et
      færdigt ærmemål.
    </p>
    <p>
      <strong>Overarm:</strong> Mål rundt om det bredeste sted på overarmen, mens
      armen hænger afslappet ned langs kroppen.
    </p>
    <p>
      <strong>Ærmegabsdybde:</strong> Mål lodret fra skulderens yderste overkant ned
      til armhulen.
    </p>
    <p>
      <strong>Midt bag i nakken til håndled:</strong> Hold armen strakt, og mål fra
      nakkens basis midt bag, over skulderen og langs armen til håndleddet.
    </p>
    <p>
      <strong>Mål til tilbehør:</strong> Mål hovedomkredsen over panden og rundt om
      hele hovedet, fodlængden på gulvet fra hælens bagside til den længste tå og
      håndomkredsen rundt om håndfladen på den dominante hånd lige under knoerne,
      uden tommelfingeren. Det er kropsmål, ikke færdige mål på huer, strømper eller
      vanter. Fodlængden er ikke en omregning af skostørrelse og er ikke nok alene
      til at vælge strømpestørrelse. Aldrene er vejledende.
    </p>

    <h2>Kropsmål eller færdige mål</h2>
    <p>
      Tabellerne viser kropsmål. Det færdige arbejde kan være mindre, lige så
      stort eller større afhængigt af opskriftens tilsigtede bevægelsesrum.
    </p>
    <p>
      <strong>Negativt bevægelsesrum:</strong> Arbejdet er mindre end kroppen. Til
      en meget tætsiddende sweater er CYC's vejledning cirka 5-10 cm mindre end det
      faktiske brystmål; huer, strømper og tætsiddende rib har deres egen projektspecifikke
      pasform.
    </p>
    <p>
      <strong>Intet bevægelsesrum:</strong> Det færdige mål er lig med det tilsvarende
      kropsmål.
    </p>
    <p>
      <strong>Positivt bevægelsesrum:</strong> Arbejdet er større end kroppen. CYC
      foreslår cirka 5–10 cm ekstra rundt om brystet til en klassisk sweaterpasform,
      ikke som en regel for alle modeller.
    </p>
    <p>
      <strong>Løs og oversize pasform:</strong> CYC foreslår cirka 10–15 cm ekstra
      rundt om brystet til en løs sweater og 15 cm eller mere til en oversize sweater.
    </p>
    <p>
      Hvis opskriften passer til et brystmål på 91,5 cm, og den færdige
      overvidde er 101,5 cm, er det positive bevægelsesrum 10 cm. Sammenlign
      både opskriftens kropsmål og målskitsens færdige mål med den ønskede
      pasform.
    </p>
    <p>
      Når du har valgt mål, kan <a href={danishToolRoutes.yarnEstimator}
        >garnberegneren</a
      > tjekke, om garnmængden virker realistisk, og <a
        href="/da/artikler/hvor-meget-garn-til-sweater/"
        >guiden til garn til en sweater</a
      > går dybere ned i størrelsesberegninger.
    </p>

    <h2>At vælge mellem to størrelser</h2>
    <p>
      Mellem to størrelser: sammenlign de færdige mål med kroppen og opskriftens
      tilsigtede bevægelsesrum. Vælg ikke automatisk en mindre størrelse til en
      tæt model eller en større til oversize. Maskemønster, fiber og en vasket,
      tørret strikkeprøve påvirker elasticitet og fald. Huer og strømper kræver
      deres eget bevægelsesrum efter opskriften; et fast tillæg garanterer ikke
      pasformen.
    </p>
    <p>
      Sammenlign også de andre mål, især hofter på længere modeller og overarm
      på tætsiddende ærmer. Hvis brystet siger M, men hofterne siger L, så kig
      på opskriftens målskema og se, om forskellen ved hofterne betyder noget
      for længde og form.
    </p>
    <p>
      Uanset hvilken størrelse du vælger, afgør <a
        href="/da/artikler/strikkeproeve-trin-for-trin/">strikkeprøven</a
      >, om det færdige arbejde faktisk passer til tallene i opskriften. Guiden <a
        href="/da/artikler/maal-strikkefasthed/"
        >sådan måler du strikkefasthed</a
      > forklarer metoden.
    </p>

    <h2>Kilder og målemetoder</h2>
    <p>
      <a href="https://www.craftyarncouncil.com/standards/body-sizing"
        >Craft Yarn Council: Kilder og målemetoder</a
      >. <a href="https://www.craftyarncouncil.com/standards/baby-size-chart"
        >Baby</a
      >, <a href="https://www.craftyarncouncil.com/standards/child-youth-sizes"
        >Barn og ung</a
      >, <a href="https://www.craftyarncouncil.com/standards/woman-size"
        >Kvinde</a
      >, <a href="https://www.craftyarncouncil.com/standards/man-size">Mand</a>, <a
        href="https://www.craftyarncouncil.com/standards/head-circumference-chart"
        >Hoved</a
      >, <a href="https://www.craftyarncouncil.com/standards/foot-size-charts"
        >Fod</a
      >, <a href="https://www.craftyarncouncil.com/standards/hand-size-charts"
        >Hånd</a
      >. <a
        href="https://media.craftyarncouncil.com/sites/default/files/images/standards/CYC_YarnStandards-2018-11-06.pdf"
        >CYC PDF</a
      >.
    </p>
    <p>
      Kilde: Craft Yarn Council. Den linkede PDF (side 17–18) afklarer to fejl i
      webtabellerne: overarmsmålet for kvinde 5XL er 19,5 tommer, og mændenes
      ryglængde går til hoften, ikke taljen. De seks øvrige modstridende mål i
      kilden er stadig uafklarede. Hjemmesiden udelader begge enhedsværdier for
      disse mål og erstatter dem ikke med rettede eller beregnede værdier.
    </p>
  </div>
</LocalizedToolPage>
