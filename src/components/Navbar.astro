---
import { getArticlesIndexPath } from "../i18n/articles";
import { getToolsIndexPath } from "../i18n/tools";
import { useTranslations } from "../i18n/ui";
import type { Lang } from "../i18n/config";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const homeHref = "/";
const toolsIndexHref = getToolsIndexPath(lang);
const joinHref = lang === "en" ? "/#join" : `${toolsIndexHref}#join`;
const articlesHref = getArticlesIndexPath(lang);
---

<header class="nav-editorial" data-nav data-menu-open="false">
  <a href={homeHref} class="brand-mark" aria-label={t("navHome")}>KnitTools</a>
  <button
    class="nav-menu-toggle"
    type="button"
    aria-label={t("navMenu")}
    aria-expanded="false"
    aria-controls="primary-navigation"
    data-nav-toggle
    data-open-label={t("navMenu")}
    data-close-label={t("navClose")}
  >
    <span class="menu-line" aria-hidden="true"></span>
    <span class="menu-line" aria-hidden="true"></span>
    <span class="menu-line" aria-hidden="true"></span>
  </button>
  <nav class="nav-links" id="primary-navigation" data-nav-links>
    <a href={toolsIndexHref}>{t("navTools")}</a>
    <a href={articlesHref}>{t("navArticles")}</a>
    <a href={joinHref} class="waitlist" aria-label={t("notifyAtLaunch")}>
      <span>{t("notifyAtLaunch")}</span>
    </a>
  </nav>
</header>

<script is:inline>
  (() => {
    const nav = document.querySelector("[data-nav]");
    if (!nav) return;
    const toggle = nav.querySelector("[data-nav-toggle]");
    const links = nav.querySelector("[data-nav-links]");
    const desktopQuery = window.matchMedia("(min-width: 641px)");

    const setMenuOpen = (open, options = {}) => {
      nav.dataset.menuOpen = open ? "true" : "false";
      nav.classList.toggle("menu-open", open);
      if (toggle) {
        toggle.setAttribute("aria-expanded", String(open));
        const label = open
          ? toggle.dataset.closeLabel
          : toggle.dataset.openLabel;
        if (label) toggle.setAttribute("aria-label", label);
      }
      if (options.restoreFocus && toggle instanceof HTMLElement) {
        toggle.focus();
      }
    };

    const onScroll = () => {
      if (window.scrollY > 80) nav.classList.add("scrolled");
      else nav.classList.remove("scrolled");
    };

    toggle?.addEventListener("click", () => {
      setMenuOpen(nav.dataset.menuOpen !== "true");
    });

    links?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("click", (event) => {
      if (nav.dataset.menuOpen !== "true") return;
      if (event.target instanceof Node && !nav.contains(event.target)) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.dataset.menuOpen === "true") {
        setMenuOpen(false, { restoreFocus: true });
      }
    });

    desktopQuery.addEventListener("change", () => {
      if (desktopQuery.matches) setMenuOpen(false);
    });

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

<style>
  .nav-editorial {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    /* Keeps the nav visually steady during cross-document view transitions. */
    view-transition-name: site-nav;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 18px 40px;
    background: transparent;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
    border-bottom: 1px solid transparent;
  }
  .nav-editorial.scrolled {
    background: var(--paper);
    border-bottom-color: var(--ink);
  }
  .brand-mark {
    font-family: var(--font-logo);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
    flex: 0 0 auto;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
    flex: 0 1 auto;
    min-width: 0;
  }
  .nav-links a {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .nav-links a:hover {
    color: var(--terracotta);
  }

  .nav-links a.waitlist {
    padding: 8px 16px;
    border: 1.5px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
  }
  .nav-links a.waitlist:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .nav-menu-toggle {
    display: none;
  }

  .menu-line {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
  }

  @media (max-width: 640px) {
    .nav-editorial {
      gap: 12px;
      padding: 14px 20px;
    }
    .brand-mark {
      font-size: 22px;
    }
    .nav-menu-toggle {
      display: inline-flex;
      width: 44px;
      height: 44px;
      flex: 0 0 auto;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 4px;
      padding: 0;
      border: 1.5px solid var(--ink);
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .nav-menu-toggle:hover {
      background: var(--ink);
      color: var(--paper);
    }
    .nav-menu-toggle:focus-visible {
      outline: 2px solid var(--terracotta);
      outline-offset: 3px;
    }
    .nav-editorial[data-menu-open="true"] {
      background: var(--paper);
      border-bottom-color: var(--ink);
    }
    .nav-editorial[data-menu-open="true"] .menu-line:first-child {
      transform: translateY(6px) rotate(45deg);
    }
    .nav-editorial[data-menu-open="true"] .menu-line:nth-child(2) {
      opacity: 0;
    }
    .nav-editorial[data-menu-open="true"] .menu-line:last-child {
      transform: translateY(-6px) rotate(-45deg);
    }
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 20px 18px;
      background: var(--paper);
      border-bottom: 1px solid var(--ink);
    }
    .nav-editorial[data-menu-open="true"] .nav-links {
      display: flex;
    }
    .nav-links a {
      font-size: 12px;
      letter-spacing: 0.12em;
      width: 100%;
      padding: 15px 0;
      border-top: 1px solid var(--paper-2);
    }
    .nav-links a.waitlist {
      margin-top: 10px;
      padding: 12px 16px;
      text-align: center;
    }
  }

  @media (max-width: 430px) {
    .nav-editorial {
      gap: 10px;
      padding: 14px 12px;
    }
    .brand-mark {
      font-size: 20px;
    }
    .nav-menu-toggle {
      width: 42px;
      height: 42px;
    }
    .nav-links {
      padding: 6px 16px 16px;
    }
    .nav-links a {
      font-size: 12px;
      letter-spacing: 0.1em;
    }
    .nav-links a.waitlist {
      padding: 12px 14px;
    }
  }
</style>
