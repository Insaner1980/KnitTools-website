---
import { PRICING_TIERS, getPrice, type PricePhase } from "../config/pricing";

interface Props {
  phase: PricePhase;
  current?: boolean;
}

const { phase, current = false } = Astro.props;
const priceDataAttributes = Object.fromEntries(
  Object.entries(PRICING_TIERS).flatMap(([tier, prices]) => [
    [`data-${tier.toLowerCase()}-launch`, prices.launch],
    [`data-${tier.toLowerCase()}-permanent`, prices.permanent],
  ]),
);
---

<span
  data-regional-price={phase}
  data-current-price={current || undefined}
  {...priceDataAttributes}>{getPrice(phase)}</span
>
