---
import LocalizedToolPage from "../LocalizedToolPage.astro";
import YarnEstimator from "../YarnEstimator.astro";
import { dutchToolRoutes } from "../../i18n/dutchTools";
import { routes } from "../../i18n/routes";

import { yarnReferenceCopy } from "../../i18n/yarnReference";
const referenceCopy = yarnReferenceCopy.nl;

const faqs = [
  { q: referenceCopy.methodTitle, a: referenceCopy.method },
  { q: referenceCopy.adviceTitle, a: referenceCopy.advice },
];
---

<LocalizedToolPage
  title="Garenberekenaar: hoeveel garen heb ik nodig?"
  description={referenceCopy.description}
  canonicalPath={dutchToolRoutes.yarnEstimator}
  lang="nl"
  alternates={routes.tool.yarnEstimator}
  intro={referenceCopy.intro}
  schemaName="Garenberekenaar"
  schemaDescription={referenceCopy.description}
  faqs={faqs}
  variant="rust"
>
  <div slot="tool">
    <YarnEstimator lang="nl" />
  </div>

  <div slot="content">
    <h2>{referenceCopy.methodTitle}</h2><p>{referenceCopy.method}</p><p>
      {referenceCopy.limitations}
    </p>
  </div>
</LocalizedToolPage>
