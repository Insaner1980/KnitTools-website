---
const items = [
  "Projects",
  "Row counter",
  "Pattern viewer",
  "Saved patterns",
  "My Yarn",
  "Gauge calculator",
  "Cast on calculator",
  "Yarn estimator",
  "Increase / decrease",
  "Needle sizes",
  "Size charts",
  "Abbreviations",
  "Chart symbols",
  "Ravelry search",
  "Progress photos",
  "Saved row counts",
  "Project stats",
  "Row counter widget",
];
---

<div class="marquee" aria-hidden="true" data-marquee>
  <div class="marquee-track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee-group">
          {items.map((item) => (
            <span>
              {item}
              <span class="dot" aria-hidden="true" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    background: var(--terracotta);
    padding: 22px 0;
    overflow: hidden;
    white-space: nowrap;
  }
  /* width: max-content on kriittinen: ilman sita inline-flex-raita kutistuu
     containerin levyiseksi, jolloin translateX(-50%) on vain puolet
     nakymasta -> mobiilissa liike on niin hidasta ettei se nay lainkaan. */
  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 60s linear infinite;
    font-family: var(--font-body);
    font-size: var(--landing-small-size);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
  }
  .marquee-group {
    display: flex;
    flex: 0 0 auto;
  }
  .marquee-group > span {
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
  }
  .marquee-track .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 18px;
    border-radius: 50%;
    background: var(--paper);
    vertical-align: middle;
    transform: translateY(-1px);
  }
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* CSS-animaatio on perustaso joka toimii ilman JS:aa. Kun GSAP ottaa
     nauhan haltuun (scrollin suunta + vauhti), se merkitsee raidan
     talla luokalla — muuten kaksi jarjestelmaa kirjoittaisi samaan
     transformiin ja nauha nykisi. Hover-pysaytys siirtyy samalla JS:lle. */
  .marquee-track.is-scroll-driven {
    animation: none;
  }
  /* Vain hiirilaitteille: kosketusnaytolla :hover jaa "jumiin" tapin jalkeen
     ja pysayttaisi raidan pysyvasti. */
  @media (hover: hover) {
    .marquee:hover .marquee-track:not(.is-scroll-driven) {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation-play-state: paused;
    }
  }
</style>
