---
import {
  PRICING,
  getLaunchDeadline,
  getPricePhase,
  type LaunchPhase,
} from "../config/pricing";
import RegionalPrice from "./RegionalPrice.astro";

interface Props {
  phase: LaunchPhase;
}
const { phase } = Astro.props;
const offerCopy = {
  prelaunch: {
    availability: "Coming to Google Play",
    label: "Planned launch price",
    detail: "First month after release",
  },
  launch: {
    availability: "Available on Google Play",
    label: "Launch price",
    detail: "Ends " + getLaunchDeadline(),
  },
  regular: {
    availability: "Available on Google Play",
    label: "KnitTools Pro",
    detail: "One-time purchase",
  },
};
const offers = Object.entries(offerCopy);
---

<section class="hero-editorial" aria-labelledby="hero-heading">
  <div class="hero-inner">
    <div class="hero-text">
      <h1 id="hero-heading" class="wordmark">
        <span class="eyebrow">An Android app for knitters and crocheters</span>
        <span class="wordmark-line">Knit</span>
        <span class="wordmark-line">Tools</span>
      </h1>
      <p class="tagline">
        <em
          >From first stitch to finished project,<br /><span class="accent"
            >one app keeps up.</span
          ></em
        >
      </p>
    </div>

    <aside class="release-card" aria-labelledby="release-heading">
      <h2 id="release-heading" class="card-head">
        {
          offers.map(([offerPhase, offer]) => (
            <span
              data-campaign-phase={offerPhase}
              hidden={phase !== offerPhase}
            >
              {offer.availability}
            </span>
          ))
        }
      </h2>
      <div class="card-price-line">
        <p class="card-price">
          <RegionalPrice phase={getPricePhase(phase)} current />
        </p>
        <p class="card-caption">
          {
            offers.map(([offerPhase, offer]) => (
              <span
                data-campaign-phase={offerPhase}
                hidden={phase !== offerPhase}
              >
                <strong>{offer.label}</strong>
                {offer.detail}
              </span>
            ))
          }
        </p>
      </div>
      <div class="card-footer">
        {
          ["prelaunch", "launch"].map((offerPhase) => (
            <p
              class="card-after"
              data-campaign-phase={offerPhase}
              hidden={phase !== offerPhase}
            >
              Then <RegionalPrice phase="permanent" />
            </p>
          ))
        }
        <p>{PRICING.trialDays}-day free trial</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero-editorial {
    position: relative;
    padding: 0.75rem 2rem;
    overflow: hidden;
    /* 80px body padding + ~70px marquee reserved so the strip is fully
       visible in the first desktop viewport. */
    min-height: calc(100svh - 150px);
    display: flex;
    align-items: center;
  }

  .hero-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero-text {
    min-width: 0;
    padding-right: 0;
  }

  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--landing-label-size);
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 28px;
    text-align: left;
  }

  .wordmark {
    font-family: var(--font-logo);
    font-weight: 500;
    font-size: clamp(4.5rem, 10vw, 10rem);
    line-height: 0.75;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    padding: 0;
    text-align: left;
  }
  .wordmark-line {
    display: block;
    line-height: 0.75;
    margin: 0;
    padding: 0;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.2;
    color: var(--ink);
    width: 100%;
    margin: 16px 0 0;
    padding: 0;
    text-align: left;
  }
  .tagline em {
    font-style: normal;
  }
  .tagline .accent {
    color: var(--terracotta);
    font-weight: 700;
  }

  .release-card {
    background: var(--paper-2);
    border: 1.5px solid var(--ink);
    padding: min(1.5rem, 5vw);
    max-width: 460px;
    container-type: inline-size;
    width: 100%;
    min-width: 0;
    justify-self: end;
    align-self: center;
  }

  .card-head {
    font-family: var(--font-body);
    font-size: var(--landing-label-size);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin: 0 0 1.25rem;
  }

  .card-price-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .card-price {
    margin: 0;
    min-width: 0;
    max-width: 100%;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 4rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .card-caption {
    flex: 1 1 9rem;
    min-width: 0;
    margin: 0;
    font-size: var(--landing-small-size);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .card-caption strong {
    display: block;
    font-size: var(--landing-body-size);
    font-weight: 600;
    color: var(--ink);
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ink);
    font-size: var(--landing-small-size);
    line-height: 1.45;
    color: var(--ink);
  }

  .card-footer p {
    margin: 0;
  }

  .card-after {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @container (max-width: 200px) {
    .card-price {
      font-size: 2rem;
    }
  }

  /* --- Entrance choreography ---
     Runs only when JS has added html.reveal-animations, so content is
     always visible without JS. Transform/opacity only; no layout shift. */
  :global(html.reveal-animations) .eyebrow,
  :global(html.reveal-animations) .wordmark-line,
  :global(html.reveal-animations) .tagline,
  :global(html.reveal-animations) .release-card {
    animation: hero-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  :global(html.reveal-animations) .eyebrow {
    animation-delay: 0.02s;
  }
  :global(html.reveal-animations) .wordmark-line {
    animation-duration: 0.75s;
    animation-delay: 0.1s;
  }
  :global(html.reveal-animations) .wordmark-line + .wordmark-line {
    animation-delay: 0.22s;
  }
  :global(html.reveal-animations) .tagline {
    animation-delay: 0.38s;
  }
  :global(html.reveal-animations) .release-card {
    animation-name: hero-rise-card;
    animation-delay: 0.5s;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-rise-card {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 900px) {
    .hero-editorial {
      min-height: auto;
      padding: 5rem 1.5rem 3.5rem;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .release-card {
      justify-self: start;
    }
    .wordmark {
      font-size: clamp(4rem, 18vw, 8rem);
    }
  }
</style>
