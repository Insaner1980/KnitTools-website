---
import type { Lang } from "../i18n/config";
import {
  CAST_ON_INPUT_LIMITS,
  CAST_ON_LOCALE_CONFIGS,
} from "../scripts/castOnCalculator";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const { copy, metricOnly, numericInputType } = CAST_ON_LOCALE_CONFIGS[lang];
---

<div
  class="cast-on-calculator"
  data-error={copy.error}
  data-result-label={copy.resultLabel}
>
  <fieldset>
    <legend class="sr-only">{copy.legend}</legend>

    <div class="form-group">
      <label for="gauge">{copy.gauge}</label>
      <div class="number-input-wrap">
        <button
          type="button"
          class="spin-btn spin-down"
          aria-label={copy.decreaseGauge}>−</button
        >
        <input
          type={numericInputType}
          inputmode="decimal"
          id="gauge"
          min={CAST_ON_INPUT_LIMITS.gauge.min}
          max={CAST_ON_INPUT_LIMITS.gauge.max}
          step={CAST_ON_INPUT_LIMITS.gauge.step}
          placeholder={copy.gaugePlaceholder}
        />
        <button
          type="button"
          class="spin-btn spin-up"
          aria-label={copy.increaseGauge}>+</button
        >
      </div>
    </div>

    <div class="form-group">
      <label for="width">{copy.width}</label>
      <div class="number-input-wrap">
        <button
          type="button"
          class="spin-btn spin-down"
          aria-label={copy.decreaseWidth}>−</button
        >
        <input
          type={numericInputType}
          inputmode="decimal"
          id="width"
          min={CAST_ON_INPUT_LIMITS.width.min}
          max={CAST_ON_INPUT_LIMITS.width.max}
          step={CAST_ON_INPUT_LIMITS.width.step}
          placeholder={copy.widthPlaceholder}
        />
        <button
          type="button"
          class="spin-btn spin-up"
          aria-label={copy.increaseWidth}>+</button
        >
      </div>
    </div>

    {
      !metricOnly && (
        <div class="form-group">
          <div
            class="unit-toggle"
            role="radiogroup"
            aria-label={copy.unitSelection}
          >
            <label class="unit-option">
              <input type="radio" name="unit" value="cm" checked />
              <span>cm</span>
            </label>
            <label class="unit-option">
              <input type="radio" name="unit" value="inches" />
              <span>{copy.inches}</span>
            </label>
          </div>
        </div>
      )
    }

    <button type="button" class="btn-primary calc-btn">{copy.calculate}</button>

    <div class="result-area" aria-live="polite">
      <div class="result-wrapper">
        <div class="result-value" id="cast-on-result"></div>
      </div>
    </div>
  </fieldset>
</div>

<script>
  import { initCastOnCalculators } from "../scripts/castOnCalculator";
  import { countUp } from "../scripts/motion";

  initCastOnCalculators(document, countUp);
</script>

<style>
  .cast-on-calculator fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .form-group {
    margin-top: 16px;
  }
  .form-group:first-child {
    margin-top: 0;
  }

  .cast-on-calculator label {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 10px;
  }

  .number-input-wrap {
    display: flex;
    align-items: stretch;
    max-width: 380px;
    border: 1.5px solid var(--ink);
    background: transparent;
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .number-input-wrap:focus-within {
    background: var(--paper-2);
    border-color: var(--terracotta);
    box-shadow: 0 4px 16px rgba(160, 80, 56, 0.15);
  }

  .cast-on-calculator input:is([type="number"], [type="text"]) {
    flex: 1;
    background: transparent;
    border: 0;
    border-left: 1.5px solid var(--ink);
    border-right: 1.5px solid var(--ink);
    border-radius: 0;
    height: 48px;
    padding: 0 18px;
    font-size: 16px;
    color: var(--ink);
    font-family: var(--body-ed);
    box-sizing: border-box;
    transition: border-color 300ms ease;
    appearance: none;
    -moz-appearance: textfield;
    text-align: center;
    min-width: 0;
  }

  .cast-on-calculator input[type="number"]::-webkit-inner-spin-button,
  .cast-on-calculator input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .spin-btn {
    width: 44px;
    background: transparent;
    border: 0;
    color: var(--terracotta);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 200ms,
      color 200ms,
      transform 100ms;
    font-family: var(--body-ed);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .spin-btn:hover {
    background: var(--terracotta);
    color: var(--paper);
  }

  .spin-btn:active {
    transform: scale(0.92);
  }

  .cast-on-calculator input::placeholder {
    color: var(--ink-soft);
  }

  .cast-on-calculator input:focus {
    outline: none;
  }

  .number-input-wrap:focus-within input:is([type="number"], [type="text"]) {
    border-color: var(--terracotta);
  }

  /* Unit Toggle — text-based with terracotta underline */
  .unit-toggle {
    display: inline-flex;
    margin-top: 20px;
    gap: 28px;
    background: transparent;
    border: 0;
    padding: 0;
    width: max-content;
  }

  .unit-option {
    cursor: pointer;
    margin: 0;
    position: relative;
  }

  .unit-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .unit-option span {
    display: block;
    padding: 6px 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1.5px solid transparent;
    transition:
      color 200ms ease,
      border-color 200ms ease;
    line-height: 1;
  }

  .unit-option:hover span {
    color: var(--ink);
  }

  .unit-option input:checked + span {
    color: var(--terracotta);
    border-bottom-color: var(--terracotta);
  }

  .unit-option input:focus-visible + span {
    outline: 2px solid var(--terracotta);
    outline-offset: 4px;
  }

  /* Calculate button — landing hero style */
  .calc-btn {
    display: inline-block;
    margin-top: 28px;
    padding: 14px 26px;
    background: var(--ink);
    color: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease !important;
  }

  .calc-btn:hover {
    background: var(--terracotta);
    border-color: var(--terracotta);
    color: var(--paper);
  }

  /* Result Area Subtly Expanding */
  .result-area {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 16px;
  }

  .result-area.is-open {
    grid-template-rows: 1fr;
  }

  .result-wrapper {
    overflow: hidden;
  }

  :global(.tool-result) {
    background: none;
    border: none;
    padding: 16px 0;
    text-align: left;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 400ms ease 200ms,
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1) 200ms;
  }

  .result-area.is-open :global(.tool-result) {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.result-number) {
    display: block;
    font-family: var(--mono);
    font-size: clamp(3rem, 6vw, 4.5rem);
    color: var(--terracotta);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  :global(.result-label) {
    display: block;
    font-family: var(--body-ed);
    font-size: 1rem;
    color: var(--ink);
    opacity: 0.7;
    margin-top: 4px;
  }

  :global(.form-error) {
    color: var(--terracotta);
    font-size: 0.85rem;
    display: block;
    padding-top: 12px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
